    {tab:"supplements",name:"Beta-alanine",type:"CONTEXT-DEPENDENT",use:"May help repeated high-intensity efforts",timing:"Works through regular use rather than a single pre-workout hit",dose:"Use evidence-based product directions rather than megadosing",risk:"Tingling/paresthesia is common; split dosing can reduce it."},
    {tab:"supplements",name:"Citrulline",type:"LIMITED / MIXED",use:"Pump/performance claims; evidence is mixed",timing:"If used, commonly studied around training",dose:"No universal FormFit dose recommendation",risk:"GI discomfort can occur; evidence is less consistent than creatine/caffeine."},
    {tab:"supplements",name:"BCAA",type:"LOW PRIORITY",use:"Usually unnecessary when total protein is adequate",timing:"No special timing required",dose:"Prefer complete protein foods/powders first",risk:"Marketing claims often exceed evidence for extra muscle/performance benefit."},
    {tab:"supplements",name:"Pre-workout blends",type:"CHECK THE LABEL",use:"Usually a mixture of caffeine and other ingredients",timing:"Depends on ingredients; stimulant load can persist for hours",dose:"Calculate total caffeine across coffee, energy drinks and supplements",risk:"Multi-ingredient blends make interactions and total exposure harder to judge."},
