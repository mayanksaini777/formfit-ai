    {tab:"steroids",name:"Oxymetholone (Anadrol)",type:"ORAL AAS • LIVER CONCERN",mechanism:"Potent oral AAS that activates androgen-receptor signalling and can strongly affect anabolic pathways.",use:"Has medical history for certain anemias; performance misuse is different from prescribed treatment.",timing:"No FormFit cycle/timing plan",dose:"No non-medical dose recommendation",risk:"Important liver, lipid, blood-pressure and hormonal concerns; serious adverse events are possible."},
    {tab:"steroids",name:"SARMs (e.g. Ostarine / LGD-4033 / RAD-140)",type:"NOT AAS • UNAPPROVED PEDs",mechanism:"Selective androgen receptor modulators are designed to activate androgen receptors more selectively than traditional AAS, but 'selective' does not mean safe or side-effect-free.",use:"Marketed online for muscle/strength and often pushed through social media; FDA says SARMs are unapproved drugs, not ordinary dietary supplements.",timing:"No FormFit use plan",dose:"No FormFit dosing",risk:"FDA warns about liver injury, heart attack/stroke risk, sexual/reproductive effects and other harms; product identity/purity can be unreliable."},
    {tab:"steroids",name:"Prohormones / designer steroids",type:"RED FLAG",mechanism:"Compounds marketed as hormone precursors or novel steroid-like molecules may be converted into active hormones or act directly on androgen pathways.",use:"Often sold as 'legal steroid alternatives' or research products.",timing:"No FormFit use plan",dose:"No FormFit dosing",risk:"May be unapproved, mislabeled or contaminated; health and anti-doping status can be difficult to predict."},
    {tab:"steroids",name:"PCT / hormone-manipulation drugs",type:"NOT A SAFETY RESET",mechanism:"Different medicines can alter estrogen/androgen signalling after hormone suppression, but the mechanism depends on the specific drug and medical indication.",use:"Often discussed online as a way to recover hormones after PED use.",timing:"No FormFit PCT protocol",dose:"No FormFit dosing",risk:"PCT is not a proven guarantee against steroid-related harm and these medicines can have their own interactions and adverse effects; clinician assessment is safer."},
    {tab:"redflags",name:"Hidden steroid / SARM products",type:"HIGH RISK",use:"Products sold as supplements or 'research' products can contain undeclared active drugs",timing:"Avoid rather than optimize",dose:"Do not rely on online dosing labels",risk:"FDA has identified bodybuilding products with steroids/steroid-like substances and serious adverse events."},
    {tab:"redflags",name:"Stacking multiple stimulants",type:"HIGH RISK",use:"Combining pre-workouts, energy drinks, caffeine pills or stimulant herbs",timing:"Timing can overlap and extend exposure",dose:"Track total caffeine rather than each product separately",risk:"Higher stimulant load can increase palpitations, anxiety, sleep disruption and other adverse effects."},
    {tab:"redflags",name:"'Test booster' claims",type:"MARKETING RED FLAG",use:"Often blends herbs, minerals or hormone-related ingredients",timing:"No magic timing",dose:"Check ingredient-specific evidence rather than marketing claims",risk:"Some bodybuilding products may contain hidden steroid-like ingredients; labels are not always reliable."},
    {tab:"redflags",name:"Research-chemical labels",type:"RED FLAG",use:"'For research only' does not establish human safety or purity",timing:"Do not treat as a normal supplement",dose:"No FormFit dosing",risk:"Unknown purity, potency and human safety; some products are unapproved drugs."}
  ];

  let currentTab = "supplements";
  let profile = null;

  function render(){
    document.querySelectorAll(".performance-intro[data-perf-intro]").forEach(el=>{
      el.hidden = el.dataset.perfIntro !== currentTab;
    });
    const q=(search?.value||"").trim().toLowerCase();
    const items=library.filter(x=>x.tab===currentTab && (!q || [x.name,x.type,x.use,x.risk].join(" ").toLowerCase().includes(q)));
    cards.innerHTML=items.length ? items.map(x=>`<article class="performance-card"><div class="pc-top"><h4>${x.name}</h4><span class="pc-type">${x.type}</span></div>${x.mechanism?`<div class="pc-mechanism"><b>HOW IT WORKS:</b> ${x.mechanism}</div>`:''}<p>${x.use}</p><div class="pc-meta"><span>WHEN: ${x.timing}</span><span>${x.dose}</span></div><div class="pc-risk"><b>SAFETY:</b> ${x.risk}</div></article>`).join("") : '<div class="day-card"><strong>No matching entries.</strong><p>Try a simpler search.</p></div>';
    if(title){title.textContent=currentTab==='supplements'?"Training supplements":currentTab==='steroids'?"Steroids & PED education":"Safety red flags";}
    if(hint){hint.textContent=currentTab==='supplements'?"Evidence-backed basics, timing and safety context for adult users.":currentTab==='steroids'?"Educational classification, risks and anti-doping context — never a cycle or dosing generator.":"Common traps in bodybuilding products, stimulant stacking and misleading labels.";}
  }

  start?.addEventListener("click",()=>{
    const age=window.prompt("18+ age gate: enter your age to continue.");
    const n=Number(age);
    if(!Number.isFinite(n) || n<18){ alert("This section is available only to adults aged 18+."); return; }
    gate.hidden=true; workspace.hidden=false;
    document.getElementById("perfAge").value=n;
    render();
  });

  tabs?.querySelectorAll("[data-perf-tab]").forEach(btn=>btn.addEventListener("click",()=>{
    currentTab=btn.dataset.perfTab;
    tabs.querySelectorAll(".performance-tab").forEach(b=>b.classList.toggle("active",b===btn));
    render();
  }));
  search?.addEventListener("input",render);

  document.querySelectorAll("#perfSafetyFlags .choice").forEach(btn=>btn.addEventListener("click",()=>{
    const none=btn.dataset.flag==='none';
    if(none){ document.querySelectorAll("#perfSafetyFlags .choice").forEach(b=>b.classList.remove("selected")); btn.classList.add("selected"); return; }
    document.querySelector('#perfSafetyFlags [data-flag="none"]')?.classList.remove("selected");
    btn.classList.toggle("selected");
  }));

  form.addEventListener("submit",e=>{
    e.preventDefault();
    const age=Number(document.getElementById("perfAge").value);
    if(age<18){ result.innerHTML='<div class="profile-result warn">18+ is required for this section.</div>'; return; }
    const flags=[...document.querySelectorAll("#perfSafetyFlags .choice.selected")].map(x=>x.dataset.flag);
    profile={age,sex:document.getElementById("perfSex").value,goal:document.getElementById("perfGoal").value,training:document.getElementById("perfTraining").value,tested:document.getElementById("perfSport").value,flags,currentUse:document.getElementById("perfCurrentUse").value.trim()};
    const highRisk=flags.some(x=>["heart-bp","liver","kidney","cholesterol","mental","fertility","meds"].includes(x));
    const tested=profile.tested==='yes';
    result.innerHTML=`<div class="profile-result ${highRisk?'warn':''}"><strong>Guidance ready.</strong> ${highRisk?'Because you selected a health/medication flag, supplement choices should be reviewed with a clinician/pharmacist. ':''}${tested?'Drug-tested sport selected: check every ingredient against the current anti-doping rules before use. ':''}For your ${profile.goal.toLowerCase()} goal, FormFit will prioritize food, training, sleep and evidence-backed supplements before anything experimental.</div>`;
  });

  render();
})();
