  favorite_foods: [],
  disliked_foods: [],
  avoid_foods: [],
  favorite_meals: [],
  notes: []
};

let activeDietPlan = null;
let activeDietProfile = null;
let savedDietCache = [];

const MEAL_GOALS = {
  bulking: {
    label: "Bulking",
    calorieFactor: 1.15,
    proteinPerKg: 1.8,
    description: "Calorie-surplus style plan with higher calories, protein and carbohydrates."
  },
  muscle_gain: {
    label: "Muscle Gain",
    calorieFactor: 1.08,
    proteinPerKg: 1.8,
    description: "Balanced high-protein plan with sufficient calories and carbohydrates."
  },
  cutting: {
    label: "Cutting",
    calorieFactor: 0.86,
    proteinPerKg: 2.0,
    description: "Controlled calories with high protein, vegetables and filling foods."
  },
  muscle_loss: {
    label: "Muscle Loss",
    calorieFactor: 0.80,
    proteinPerKg: 2.0,
    description: "Calorie-deficit oriented plan while keeping protein relatively high."
  },
  maintaining: {
    label: "Maintaining",
    calorieFactor: 1.00,
    proteinPerKg: 1.6,
    description: "Balanced maintenance-style intake for everyday eating."
  }
};

const DIET_SUPPLEMENTS = {
  protein_powder: { name: "Protein Powder", image: "assets/supplements/protein-powder.svg", timing: "Post-workout or any meal where protein is short", guide: "Use the serving size on your product label", note: "Useful when food alone makes your protein target hard to reach." },
  creatine: { name: "Creatine Monohydrate", image: "assets/supplements/creatine.svg", timing: "Daily consistency; timing is not critical", guide: "Common adult maintenance use is 3–5 g/day; follow your product label", note: "One of the better-supported options for repeated high-intensity training." },
  multivitamin: { name: "Multivitamin", image: "assets/supplements/multivitamin.svg", timing: "With a main meal", guide: "Follow the product label and avoid duplicate vitamin/mineral products", note: "It supports micronutrient intake but does not replace a varied diet." },
  omega3: { name: "Omega-3 / Fish Oil", image: "assets/supplements/omega3.svg", timing: "With a meal", guide: "Follow the label and check the EPA + DHA amount", note: "Check with a clinician if you use blood-thinning medicines or have a bleeding disorder." },
  vitamin_d: { name: "Vitamin D3", image: "assets/supplements/vitamin-d3.svg", timing: "With a meal containing some fat", guide: "Use when appropriate for diet, labs or clinician advice; avoid automatic high-dose use", note: "Need depends on individual context rather than the workout goal alone." },
  electrolytes: { name: "Electrolytes", image: "assets/supplements/electrolytes.svg", timing: "Around long, hot or very sweaty sessions", guide: "Follow the product label and your fluid/sweat needs", note: "For many normal sessions, regular food and water are enough." },
  caffeine: { name: "Caffeine", image: "assets/supplements/caffeine.svg", timing: "Usually 15–60 min before training", guide: "Track total caffeine from all sources and follow the product label", note: "Avoid late use if it disrupts sleep or causes unwanted symptoms." },
  beta_alanine: { name: "Beta-Alanine", image: "assets/supplements/beta-alanine.svg", timing: "Daily use matters more than a single pre-workout dose", guide: "Follow the product label; split doses if tingling is uncomfortable", note: "More relevant to certain high-intensity efforts than to every workout." }
};

function getSelectedDietSupplements(profile) {
  if (!profile || profile.supplementMode !== "use") return [];
  return (profile.supplements || []).filter(key => DIET_SUPPLEMENTS[key]);
}

const WORKOUT_TIME_LABELS = {
  morning: "Morning",
  evening: "Evening",
  night: "Night"
};

function getWorkoutMealMap(workoutTime) {
  // Keep the supplement inside an actual meal slot so the generated plan
  // reads like a schedule, not a detached supplement checklist.
  if (workoutTime === "morning") {
    return { pre: "breakfast", post: "mid", main: "lunch" };
  }
  if (workoutTime === "night") {
    return { pre: "dinner", post: "bedtime", main: "lunch" };
  }
  return { pre: "evening", post: "dinner", main: "lunch" };
}

function getSupplementPlacement(key, profile) {
  const map = getWorkoutMealMap(profile?.workoutTime || "evening");
  if (key === "protein_powder") return { meal: map.post, label: "POST-WORKOUT" };
  if (key === "caffeine") return { meal: map.pre, label: "PRE-WORKOUT" };
  if (key === "electrolytes") return { meal: map.pre, label: "AROUND WORKOUT" };
  if (key === "beta_alanine") return { meal: map.pre, label: "PRE-WORKOUT / DAILY" };
  if (key === "creatine") return { meal: map.post, label: "POST-WORKOUT / DAILY" };
  return { meal: map.main, label: "WITH MAIN MEAL" };
}

function getMealSupplementItems(mealKey, profile) {
  return getSelectedDietSupplements(profile)
    .map(key => ({ key, data: DIET_SUPPLEMENTS[key], placement: getSupplementPlacement(key, profile) }))
    .filter(x => x.placement.meal === mealKey);
}

function renderMealSupplementBlock(mealKey, profile) {
  const items = getMealSupplementItems(mealKey, profile);
  if (!items.length) return "";
  return `
    <div class="meal-supplement-block">
      <div class="meal-supplement-block-head"><span>SUPPLEMENTS</span><small>${escapeHtml(WORKOUT_TIME_LABELS[profile?.workoutTime || "evening"] || "Evening")} workout plan</small></div>
      <div class="meal-supplement-meal-list">
        ${items.map(({data, placement}) => `
          <div class="meal-supplement-line">
            <span class="meal-supplement-icon"><img src="${data.image}" alt="${escapeHtml(data.name)}" loading="lazy"></span>
            <div><strong>${escapeHtml(data.name)}</strong><span>${escapeHtml(placement.label)}</span><small>${escapeHtml(data.timing)}</small></div>
          </div>`).join("")}
      </div>
    </div>`;
}

function renderWorkoutTimingCard(profile) {
  const time = profile?.workoutTime || "evening";
  const map = getWorkoutMealMap(time);
  const selected = getSelectedDietSupplements(profile);
  return `
    <div class="diet-workout-timing-card">
      <div><span class="eyebrow">WORKOUT-AWARE MEAL TIMING</span><h3>${escapeHtml(WORKOUT_TIME_LABELS[time] || "Evening")} training</h3></div>
      <div class="diet-workout-timing-grid">
        <div><b>PRE-WORKOUT</b><span>${escapeHtml(MEAL_LABELS[map.pre])}</span></div>
        <div><b>POST-WORKOUT</b><span>${escapeHtml(MEAL_LABELS[map.post])}</span></div>
        <div><b>SUPPLEMENTS</b><span>${selected.length ? `${selected.length} selected` : "Food-first"}</span></div>
      </div>
    </div>`;
}

function renderDietSupplementCard(profile) {
  const selected = getSelectedDietSupplements(profile);
  if (profile?.supplementMode !== "use") return `
    <div class="diet-supplement-card">
      <div class="diet-supplement-head"><div><span class="eyebrow">SUPPLEMENT PREFERENCE</span><h3>Food-only plan</h3></div><span class="diet-memory-badge">NO SUPPLEMENTS</span></div>
      <p>Your meal plan stays food-first. No supplement entries were added.</p>
    </div>`;
  if (!selected.length) return `
    <div class="diet-supplement-card">
      <div class="diet-supplement-head"><div><span class="eyebrow">SUPPLEMENT PREFERENCE</span><h3>None selected</h3></div><span class="diet-memory-badge">0 SELECTED</span></div>
      <p>You chose supplements, but none are selected yet.</p>
    </div>`;
  return `
    <div class="diet-supplement-card">
      <div class="diet-supplement-head"><div><span class="eyebrow">SUPPLEMENTS IN THIS PLAN</span><h3>${selected.length} selected</h3></div><span class="diet-memory-badge">USER SELECTED</span></div>
      <div class="diet-supplement-grid">
        ${selected.map(key => { const x = DIET_SUPPLEMENTS[key]; const placement = getSupplementPlacement(key, profile); return `<div class="diet-supplement-item"><span class="diet-supplement-icon"><img src="${x.image}" alt="${escapeHtml(x.name)}" loading="lazy"></span><div><strong>${escapeHtml(x.name)}</strong><span>${escapeHtml(placement.label)} • ${escapeHtml(MEAL_LABELS[placement.meal])}</span><small>${escapeHtml(x.timing)}</small><em>${escapeHtml(x.guide)} • ${escapeHtml(x.note)}</em></div></div>`; }).join("")}
      </div>
      <p class="diet-supplement-note">Timing is matched to your selected ${escapeHtml(WORKOUT_TIME_LABELS[profile?.workoutTime || "evening"] || "Evening")} workout. Supplement calories/macros stay separate because serving sizes vary by product.</p>
    </div>`;
}

