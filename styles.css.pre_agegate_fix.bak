
:root{
  --bg:#071014;--panel:#0d191e;--panel2:#101f25;--line:#1b3037;
  --text:#f3f7f6;--muted:#8fa5aa;--accent:#79f2a4;--yellow:#f4d35e;
  --red:#ff5c68;--blue:#76b8ff;--shadow:0 20px 70px rgba(0,0,0,.28);
}
*{box-sizing:border-box}body{margin:0;background:radial-gradient(circle at 80% 10%,#123128 0,#071014 34%),var(--bg);color:var(--text);font-family:Inter,system-ui,sans-serif}
button,input,select{font:inherit}.app-shell{min-height:100vh;display:flex}.sidebar{width:255px;border-right:1px solid var(--line);padding:27px 18px;display:flex;flex-direction:column;background:rgba(5,14,18,.88);position:fixed;inset:0 auto 0 0;z-index:5}
.brand{display:flex;align-items:center;gap:12px;padding:4px 9px 35px}.brand-mark{width:39px;height:39px;border-radius:12px;background:var(--accent);color:#05100a;display:grid;place-items:center;font-weight:900;font-size:20px}.brand-name{font:800 18px Manrope}.brand-sub{font-size:8px;letter-spacing:2px;color:var(--muted);margin-top:2px}
nav{display:grid;gap:7px}.nav-item{border:1px solid transparent;background:transparent;color:var(--muted);padding:12px 13px;border-radius:12px;text-align:left;cursor:pointer;display:flex;gap:12px;align-items:center}.nav-item:hover,.nav-item.active{background:#112127;color:var(--text);border-color:#1b353b}.nav-item.active{box-shadow:inset 3px 0 var(--accent)}.sidebar-card{margin-top:auto;background:linear-gradient(145deg,#112c25,#0d191e);border:1px solid #1d4034;border-radius:18px;padding:17px}.sidebar-card strong{display:block;font:700 16px Manrope;margin:7px 0}.sidebar-card p{color:var(--muted);font-size:12px;line-height:1.6;margin:0}.tiny-label,.eyebrow{font-size:10px;letter-spacing:2px;color:#779196;font-weight:700}.sidebar-footer{font-size:10px;color:#50666b;text-align:center;padding-top:18px}
.main{margin-left:255px;width:calc(100% - 255px);padding:28px 42px 60px}.topbar{display:flex;justify-content:space-between;align-items:flex-end;border-bottom:1px solid var(--line);padding-bottom:24px;margin-bottom:32px}.topbar h1{font:800 27px Manrope;margin:7px 0 0}.top-actions{display:flex;gap:10px}.primary-btn,.secondary-btn,.ghost-btn{border-radius:11px;padding:11px 17px;border:1px solid transparent;cursor:pointer;font-weight:700;transition:.2s}.primary-btn{background:var(--accent);color:#06110a}.primary-btn:hover{transform:translateY(-1px);filter:brightness(1.05)}.secondary-btn{background:#13242a;color:var(--text);border-color:#274149}.ghost-btn{background:transparent;color:var(--muted);border-color:var(--line)}.big{padding:14px 20px}.full{width:100%;margin-top:20px}
.view{display:none}.active-view{display:block}.hero{min-height:410px;border:1px solid var(--line);border-radius:25px;background:linear-gradient(110deg,#0c191e 0%,#0d201d 100%);display:grid;grid-template-columns:1.2fr .8fr;overflow:hidden;box-shadow:var(--shadow)}.hero-copy{padding:55px}.pill{font-size:9px;letter-spacing:2px;color:var(--accent);border:1px solid #24563c;padding:7px 10px;border-radius:30px}.hero h2{font:800 48px/1.05 Manrope;margin:22px 0 17px}.hero h2 em{font-style:normal;color:var(--accent)}.hero p{color:var(--muted);max-width:540px;line-height:1.7}.hero-actions{display:flex;gap:10px;margin-top:28px}.hero-visual{position:relative;display:grid;place-items:center;overflow:hidden}.orb{position:absolute;border-radius:50%;filter:blur(2px)}.orb-a{width:330px;height:330px;background:#173d2d;right:20px;top:40px}.orb-b{width:160px;height:160px;background:#183039;left:40px;bottom:20px}.pose-card{width:230px;height:300px;border:1px solid #3d7058;border-radius:28px;background:rgba(8,18,18,.7);position:relative;z-index:1;box-shadow:0 20px 60px #0008}.pose-head{position:absolute;width:40px;height:40px;border:5px solid var(--accent);border-radius:50%;left:95px;top:34px}.pose-body{position:absolute;width:6px;height:105px;background:var(--accent);left:112px;top:79px;border-radius:10px}.pose-limb{position:absolute;height:5px;background:var(--accent);border-radius:10px;transform-origin:left}.l1{width:78px;left:113px;top:104px;transform:rotate(28deg)}.l2{width:76px;left:113px;top:105px;transform:rotate(150deg)}.l3{width:85px;left:112px;top:178px;transform:rotate(55deg)}.l4{width:85px;left:112px;top:178px;transform:rotate(125deg)}.pose-dot{position:absolute;width:11px;height:11px;border-radius:50%;background:var(--yellow);box-shadow:0 0 16px #f4d35e88}.d1{left:181px;top:139px}.d2{left:44px;top:139px}.d3{left:181px;top:225px}.d4{left:44px;top:225px}.pose-status{position:absolute;bottom:20px;left:20px;color:var(--accent);font-size:10px;letter-spacing:1px}
.stats-row{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin:14px 0 40px}.stat-card,.feature-card,.form-card,.exercise-card,.coach-panel{background:var(--panel);border:1px solid var(--line);border-radius:17px}.stat-card{padding:18px}.stat-card span{font-size:9px;letter-spacing:1.5px;color:var(--muted)}.stat-card strong{display:block;font:800 27px Manrope;margin:7px 0}.stat-card small{color:#5f767b}.section-head{margin:25px 0 18px}.section-head h2,.section-head h3{font:800 28px Manrope;margin:7px 0}.section-head p{color:var(--muted);line-height:1.6;margin:7px 0}.feature-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:13px}.feature-card{padding:23px}.feature-num{color:var(--accent);font-weight:800}.feature-card h4{font:700 17px Manrope;margin:13px 0 8px}.feature-card p{color:var(--muted);font-size:13px;line-height:1.7}
.form-card{padding:26px;max-width:850px}.form-section{margin-bottom:25px}.form-section label{display:block;font-size:12px;font-weight:700;margin-bottom:10px}.choice-grid{display:flex;flex-wrap:wrap;gap:9px}.choice{background:#0b171c;color:var(--muted);border:1px solid #20363d;padding:10px 14px;border-radius:10px;cursor:pointer}.choice.selected{color:#06110a;background:var(--accent);border-color:var(--accent);font-weight:700}.choice-grid.compact .choice{font-size:12px}.form-row{display:grid;grid-template-columns:1fr 1fr 1fr;gap:15px}select,input{width:100%;background:#0a161b;color:var(--text);border:1px solid #233a41;border-radius:10px;padding:12px;outline:none}input:focus,select:focus{border-color:#3c7660}.submit-btn{margin-top:3px}.plan-result{margin-top:25px;display:grid;gap:12px}.day-card{background:var(--panel);border:1px solid var(--line);border-radius:17px;padding:20px}.day-card h3{margin:0 0 13px;font:700 18px Manrope}.plan-ex{
  appearance:none;
  -webkit-appearance:none;
  width:100%;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:15px;
  border:0;
  border-top:1px solid #1a2b31;
  border-radius:0;
  padding:14px 10px;
  margin:0;
  background:transparent;
  color:var(--text);
  box-shadow:none;
  outline:none;
  text-align:left;
  font:inherit;
  cursor:pointer;
  transition:background .18s ease,padding .18s ease,border-color .18s ease;
}

.plan-ex:first-of-type{border-top:0}

.plan-ex:hover{
  background:linear-gradient(90deg,rgba(121,242,164,.08),rgba(121,242,164,.025));
  padding-left:14px;
  padding-right:14px;
}

.plan-ex:focus-visible{
  outline:2px solid rgba(121,242,164,.65);
  outline-offset:-2px;
  border-radius:10px;
}

.plan-ex > div{min-width:0}

.plan-ex strong{
  display:block;
  color:var(--text);
  font-size:13px;
  font-weight:800;
  line-height:1.3;
}

.plan-ex small{
  display:block;
  color:var(--muted);
  margin-top:5px;
  line-height:1.45;
}

.plan-ex .badge{
  flex:0 0 auto;
  font-size:9px;
  color:var(--accent);
  border:1px solid #24563c;
  background:rgba(36,86,60,.10);
  padding:6px 9px;
  border-radius:999px;
  white-space:nowrap;
}
.library-head{display:flex;justify-content:space-between;align-items:end}.library-tools{display:flex;gap:8px;width:420px}.exercise-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:13px}.exercise-card{padding:19px;cursor:pointer;transition:.2s}.exercise-card:hover{border-color:#3b6356;transform:translateY(-2px)}.exercise-top{display:flex;justify-content:space-between;gap:8px}.exercise-card h4{font:700 16px Manrope;margin:12px 0 7px}.exercise-card p{font-size:11px;color:var(--muted);line-height:1.6;margin:0 0 14px}.tag{display:inline-block;font-size:9px;color:#9ab0b5;background:#13242a;padding:5px 7px;border-radius:6px;margin:2px}.ready{color:var(--accent)}.basic{color:var(--yellow)}.coming{color:#829397}
.form-checker{display:grid;grid-template-columns:1.5fr .5fr;gap:15px}.camera-card{border:1px solid var(--line);border-radius:18px;background:#040b0e;min-height:500px;overflow:hidden}.camera-placeholder{height:100%;min-height:500px;display:grid;place-items:center;align-content:center;text-align:center;padding:30px;position:relative}.camera-placeholder h3{font:700 22px Manrope;margin:10px}.camera-placeholder p{color:var(--muted);max-width:480px;line-height:1.7}.camera-icon{font-size:60px;color:#28434a}.camera-placeholder video{display:none;width:100%;height:100%;object-fit:cover;position:absolute;inset:0}.coach-panel{padding:23px;height:max-content}.coach-status{margin:17px 0;padding:11px;border-radius:10px;background:#241f0c;color:var(--yellow);font-weight:700;font-size:11px}.coach-cue{display:flex;gap:8px;padding:13px 0;border-bottom:1px solid #1b2c31;color:var(--accent);font-size:12px}.coach-cue span{color:var(--muted)}

@media(max-width:1050px){.sidebar{width:80px}.brand-name,.brand-sub,.nav-item span,.sidebar-card,.sidebar-footer{display:none}.main{margin-left:80px;width:calc(100% - 80px);padding:24px}.hero{grid-template-columns:1fr}.hero-visual{min-height:350px}.stats-row{grid-template-columns:repeat(2,1fr)}.exercise-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:700px){.main{padding:17px}.topbar{align-items:flex-start;gap:12px}.top-actions{display:none}.hero-copy{padding:30px}.hero h2{font-size:38px}.feature-grid,.exercise-grid,.form-checker,.form-row{grid-template-columns:1fr}.library-head{display:block}.library-tools{width:100%;margin-top:15px}.stats-row{grid-template-columns:1fr 1fr}}


/* V4 SMOOTH FORM OVERLAY */
#cameraArea {
  position: relative;
  overflow: hidden;
}

#cameraVideo {
  transform: scaleX(-1);
  will-change: transform;
}

#poseOverlay {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 3;
  will-change: contents;
}


/* ============================================================
   FORMFIT V4.1 — HIGH VISIBILITY FORM HEADER
   Makes exercise name + view/score/reps readable from distance.
   ============================================================ */

#formView .section-head {
  margin-bottom: 22px;
}

#formView .section-head h2#selectedExerciseTitle {
  display: inline-flex;
  align-items: center;
  min-height: 52px;
  margin: 8px 0 13px;
  padding: 7px 18px 9px;
  border-radius: 12px;
  background: linear-gradient(
    135deg,
    rgba(121, 242, 164, 0.13),
    rgba(121, 242, 164, 0.045)
  );
  border: 1px solid rgba(121, 242, 164, 0.34);
  box-shadow:
    0 0 0 1px rgba(121, 242, 164, 0.04),
    0 8px 30px rgba(0, 0, 0, 0.22);
  color: #ffffff;
  font: 800 32px/1.1 Manrope, Inter, sans-serif;
  letter-spacing: -0.6px;
  text-shadow: 0 2px 14px rgba(0, 0, 0, 0.55);
}

#formView .section-head #selectedExerciseMeta {
  display: block;
  width: fit-content;
  max-width: 100%;
  margin: 0;
  padding: 11px 17px;
  border-radius: 10px;
  background: #13262d;
  border: 1px solid #31515a;
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.035),
    0 7px 24px rgba(0, 0, 0, 0.25);

  color: #f4fbfa;
  font: 800 18px/1.35 Inter, sans-serif;
  letter-spacing: 0.15px;
  text-shadow: 0 1px 8px rgba(0, 0, 0, 0.65);
}

/* Give the live status extra visual priority. */
#formView .coach-status {
  font-size: 15px;
  line-height: 1.35;
  letter-spacing: 0.15px;
  font-weight: 800;
  padding: 13px 15px;
  border-width: 1px;
}

/* On smaller screens, keep the text readable without overflowing. */
@media (max-width: 700px) {
  #formView .section-head h2#selectedExerciseTitle {
    font-size: 25px;
    min-height: 44px;
    padding: 6px 13px 7px;
  }

  #formView .section-head #selectedExerciseMeta {
    font-size: 14px;
    padding: 9px 12px;
  }
}


/* FORMFIT V9 — low-latency camera overlay */
#cameraArea {
  position: relative;
  contain: layout paint;
  isolation: isolate;
}

#cameraVideo {
  transform: scaleX(-1);
  backface-visibility: hidden;
}

#poseOverlay {
  transform: translateZ(0);
  backface-visibility: hidden;
  will-change: contents;
  pointer-events: none;
}

/* Surgical overlay alignment fix: video and skeleton share one stacking context. */
#cameraArea { position: relative; isolation: isolate; }
#cameraVideo { z-index: 1; }
#poseOverlay { z-index: 4; }


/* ============================================================
   FORMFIT UI V3 — PROFESSIONAL FORM CHECKER DASHBOARD
   UI ONLY. Camera/pose overlay canvas remains untouched.
   ============================================================ */
.form-dashboard{min-height:calc(100vh - 70px);display:flex;flex-direction:column;gap:14px}
.form-topline{display:flex;justify-content:space-between;align-items:center;gap:18px}
.form-title-wrap{display:flex;align-items:center;gap:18px}
.form-title-wrap h2{margin:0;font:800 38px/1 Manrope,Inter,sans-serif;letter-spacing:-1px;color:#fff}
.form-title-wrap .eyebrow{color:var(--accent);font-size:10px}
.run-pill{border:1px solid #234139;background:#0b181b;border-radius:999px;padding:10px 16px;color:#8fa5aa;font-size:11px;letter-spacing:.8px;white-space:nowrap}
.run-pill span{display:inline-block;width:9px;height:9px;border-radius:50%;background:var(--accent);box-shadow:0 0 12px #79f2a4;margin-right:7px}
.run-pill b{color:var(--accent)}
.form-session-bar{background:#10242a;border:1px solid #2d4d55;border-radius:12px;padding:14px 18px;font-weight:800;font-size:14px;letter-spacing:.15px;color:#f4fbfa;box-shadow:inset 0 1px rgba(255,255,255,.03)}
.form-main-grid{display:grid;grid-template-columns:minmax(0,1fr) 315px;gap:15px;min-height:500px}
.form-camera-card{min-height:500px;border-radius:18px;overflow:hidden;border:1px solid #29434a;background:#02080b;box-shadow:0 18px 60px rgba(0,0,0,.24)}
.form-camera-card .camera-placeholder{min-height:500px;padding:0;background:#02080b}
.form-camera-card .camera-placeholder video{object-fit:cover}
.form-camera-card #cameraArea{background:#02080b}
.form-camera-card #cameraArea:has(video[style*="display: block"]) .camera-icon{display:none}
.form-coaching-card{background:linear-gradient(180deg,#0c1a1f,#0a161a);border:1px solid #223c43;border-radius:18px;padding:21px;min-height:500px;box-shadow:0 18px 60px rgba(0,0,0,.2)}
.panel-eyebrow{font-size:10px;letter-spacing:2px;font-weight:800;color:#81989d;margin-bottom:12px}
.form-coaching-card .coach-status{margin:0 0 16px;border:1px solid rgba(244,211,94,.18);font-size:14px;padding:13px 14px;line-height:1.35}
.feedback-list{display:flex;flex-direction:column}
.feedback-row{display:flex;gap:11px;align-items:flex-start;padding:15px 2px;border-bottom:1px solid #1b3036;color:#8fa5aa;font-size:12px;line-height:1.45}
.feedback-row span{flex:0 0 7px;width:7px;height:7px;border-radius:50%;background:var(--accent);margin-top:5px;box-shadow:0 0 10px rgba(121,242,164,.35)}
.feedback-row b{font-weight:500}
.form-coaching-card .full{margin-top:18px}
.tip-strip{display:flex;align-items:center;gap:11px;min-height:54px;background:#0c1a1f;border:1px solid #29434a;border-radius:13px;padding:11px 16px;color:#dce8e6;font-size:12px}
.tip-icon{width:30px;height:30px;border-radius:9px;display:grid;place-items:center;color:var(--yellow);background:#231f0e;font-size:18px}
.tip-strip span{color:var(--yellow);font-weight:900;letter-spacing:.5px;margin-right:5px}
.tip-strip b{font-weight:600}
.metrics-grid{display:grid;grid-template-columns:1.2fr repeat(5,1fr);gap:10px}
.metric-card{min-height:128px;background:linear-gradient(180deg,#0d1a1f,#0a1519);border:1px solid #213941;border-radius:15px;padding:17px 16px;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center}
.metric-card>span{font-size:9px;letter-spacing:1.6px;color:#7f969b;font-weight:800}
.metric-card>strong{font:800 30px/1.1 Manrope;margin:11px 0 6px;color:#fff}
.metric-card>em{font-style:normal;font-size:10px;font-weight:800;color:var(--yellow);letter-spacing:.5px}
.metric-card:nth-child(3)>strong{color:var(--accent)}
.score-card{align-items:center}
.score-ring{width:72px;height:72px;border-radius:50%;border:7px solid #25373d;border-top-color:var(--yellow);border-right-color:var(--yellow);display:flex;align-items:center;justify-content:center;gap:1px;margin:8px 0 3px;transform:rotate(-35deg)}
.score-ring strong,.score-ring small{transform:rotate(35deg)}
.score-ring strong{font:800 25px/1 Manrope!important;margin:0!important}
.score-ring small{font-size:9px;color:#9aaeb2;margin-top:13px}
.score-card em{color:var(--yellow)}
.bottom-status{display:flex;justify-content:space-between;align-items:center;padding:11px 14px;border-top:1px solid #1c3037;color:#80969b;font-size:10px;letter-spacing:1px}
.bottom-status b{color:var(--accent)}
.live-dot{display:inline-block;width:9px;height:9px;border-radius:50%;background:var(--accent);box-shadow:0 0 12px rgba(121,242,164,.55);margin-right:7px}
.analysis-meter{display:inline-block;width:100px;height:6px;background:#203239;border-radius:999px;overflow:hidden;margin:0 7px;vertical-align:middle}
.analysis-meter i{display:block;height:100%;width:82%;background:var(--accent);border-radius:999px}
.hidden-form-copy{display:none}

@media(max-width:1100px){.form-main-grid{grid-template-columns:minmax(0,1fr) 280px}.metrics-grid{grid-template-columns:repeat(3,1fr)}}
@media(max-width:800px){.form-topline{align-items:flex-start;flex-direction:column}.form-title-wrap h2{font-size:31px}.form-main-grid{grid-template-columns:1fr}.form-coaching-card{min-height:auto}.metrics-grid{grid-template-columns:repeat(2,1fr)}}


/* ============================================================
   FORMFIT V4 — METRICS POSITION ONLY
   VISUAL/UI ONLY. DO NOT TOUCH POSE/PIPES/MODEL.
   ============================================================ */

.form-main-grid{
  display:grid;
  grid-template-columns:175px minmax(420px,1fr) 285px;
  gap:14px;
  align-items:stretch;
}

.form-left-metrics{
  display:flex;
  flex-direction:column;
  gap:12px;
}

.form-left-metrics .metric-card,
.form-left-metrics .guide-card{
  background:linear-gradient(145deg,#0c191e,#0a1519);
  border:1px solid #20353c;
  border-radius:16px;
  box-shadow:0 16px 45px rgba(0,0,0,.18);
}

.form-left-metrics .metric-card{
  padding:15px;
  text-align:center;
}

.form-left-metrics .metric-card span,
.form-left-metrics .guide-card > span{
  display:block;
  font-size:9px;
  letter-spacing:1.5px;
  color:#a6b8ba;
  font-weight:800;
}

.form-left-metrics .metric-card strong{
  display:block;
  margin:8px 0 4px;
  font:800 28px Manrope;
  color:#f4b942;
}

.form-left-metrics .metric-card em{
  font-style:normal;
  font-size:9px;
  color:#789094;
  letter-spacing:1px;
}

.form-left-metrics .score-card{padding:14px}
.form-left-metrics .score-ring{
  width:88px;height:88px;margin:9px auto;
}

.form-left-metrics .guide-card{
  padding:15px;
  text-align:center;
}

.form-left-metrics .guide-card b{
  display:block;
  margin:8px 0 6px;
  font:800 14px Manrope;
}

.form-left-metrics .guide-card p{
  margin:0;
  color:#9bb0b3;
  font-size:10px;
  line-height:1.45;
}

.form-left-metrics .guide-mini{
  display:flex;
  justify-content:center;
  align-items:center;
  gap:10px;
  margin-top:12px;
}

.form-left-metrics .guide-bad,
.form-left-metrics .guide-good{
  width:27px;height:27px;border-radius:50%;
  display:grid;place-items:center;
  font-size:18px;font-weight:900;
}

.form-left-metrics .guide-bad{background:#38171c;color:#ff5c68}
.form-left-metrics .guide-good{background:#173525;color:#79f2a4}
.form-left-metrics .guide-arrow{color:#c9d5d5;font-size:19px}

.reps-card{
  margin-bottom:16px;
  padding:14px 14px 16px;
  border:1px solid #3a4a51;
  border-radius:15px;
  background:linear-gradient(145deg,#111c22,#0b1419);
  text-align:center;
  box-shadow:0 14px 40px rgba(0,0,0,.22);
}

.reps-card-head{
  display:flex;justify-content:space-between;align-items:center;
  color:#b8c6c7;font-size:9px;letter-spacing:1.5px;font-weight:800;
}

.reps-reset{color:#f4b942;font-size:18px}

.reps-card strong{
  display:block;
  margin:5px 0 0;
  font:800 54px/1 Manrope;
  letter-spacing:2px;
  color:#e9f5f4;
}

.reps-card em{
  display:block;
  margin-top:8px;
  font-style:normal;
  font-size:9px;
  letter-spacing:1px;
  color:#9aaeb0;
}

.mini-session-stats{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:8px;
  margin-top:14px;
}

.mini-session-stats > div{
  padding:9px 7px;
  border:1px solid #20353c;
  border-radius:10px;
  background:#091419;
  text-align:center;
}

.mini-session-stats span,
.mini-session-stats small{
  display:block;font-size:7px;letter-spacing:1px;color:#72888c;
}

.mini-session-stats strong{
  display:block;margin:4px 0;
  font:800 17px Manrope;color:#f2f8f7;
}

@media(max-width:1250px){
  .form-main-grid{grid-template-columns:155px minmax(380px,1fr) 255px}
}

@media(max-width:980px){
  .form-main-grid{grid-template-columns:1fr}
  .form-left-metrics{display:grid;grid-template-columns:repeat(3,1fr)}
  .form-left-metrics .guide-card{grid-column:1 / -1}
}

@media(max-width:650px){
  .form-left-metrics{grid-template-columns:1fr}
}


/* ============================================================
   FORMFIT AUTH + PERSONAL HISTORY
   UI ONLY — pose/pipes styles untouched.
   ============================================================ */
.auth-overlay{position:fixed;inset:0;z-index:9999;display:none;place-items:center;padding:24px;background:rgba(2,8,11,.86);backdrop-filter:blur(16px)}
.auth-overlay.visible{display:grid}
.auth-card{width:min(460px,100%);background:linear-gradient(145deg,#0c1a1f,#081216);border:1px solid #29464d;border-radius:24px;padding:30px;box-shadow:0 30px 100px rgba(0,0,0,.55)}
.auth-brand{display:flex;align-items:center;gap:12px;margin-bottom:26px}.auth-brand strong{display:block;font:800 20px Manrope}.auth-brand small{display:block;color:#72888c;font-size:8px;letter-spacing:2px;margin-top:3px}.auth-brand .brand-mark{width:44px;height:44px}
.auth-card h2{font:800 31px/1.1 Manrope;margin:8px 0}.auth-card>p{color:#91a8ac;font-size:13px;line-height:1.6;margin:0 0 20px}.auth-tabs{display:grid;grid-template-columns:1fr 1fr;background:#071115;border:1px solid #203940;border-radius:12px;padding:4px;margin-bottom:20px}.auth-tab{border:0;background:transparent;color:#789095;padding:10px;border-radius:9px;font-weight:800;cursor:pointer}.auth-tab.active{background:#173028;color:#79f2a4}.auth-card form{display:flex;flex-direction:column;gap:8px}.auth-card label{font-size:10px;letter-spacing:1.2px;text-transform:uppercase;color:#91a8ac;font-weight:800;margin-top:5px}.auth-card input{width:100%;box-sizing:border-box;background:#071115;border:1px solid #28434a;color:#eef8f6;border-radius:11px;padding:13px 14px;outline:none}.auth-card input:focus{border-color:#5de994;box-shadow:0 0 0 3px rgba(93,233,148,.08)}.auth-error{min-height:18px;color:#ff6673;font-size:11px;margin-top:4px}.auth-security{display:block;color:#657d82;font-size:10px;line-height:1.5;margin-top:15px;text-align:center}
.account-card{display:flex;align-items:center;gap:9px;margin-top:auto;padding:11px;border:1px solid #203940;border-radius:13px;background:#091519}.account-avatar{width:32px;height:32px;border-radius:10px;background:#79f2a4;color:#06100c;display:grid;place-items:center;font-weight:900}.account-info{min-width:0;flex:1}.account-info span{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:10px;font-weight:800;color:#d8e5e3}.account-info small{color:#668086;font-size:8px}.logout-btn{border:0;background:transparent;color:#789095;font-size:18px;cursor:pointer}.logout-btn:hover{color:#ff6673}
.history-summary{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:20px 0}.history-stat{background:linear-gradient(180deg,#0d1a1f,#0a1519);border:1px solid #213941;border-radius:15px;padding:18px}.history-stat span{font-size:9px;letter-spacing:1.5px;color:#7f969b;font-weight:800}.history-stat strong{display:block;font:800 28px Manrope;color:#f4f8f7;margin-top:8px}.history-list{display:flex;flex-direction:column;gap:10px}.history-item{display:flex;justify-content:space-between;gap:20px;align-items:center;background:linear-gradient(180deg,#0d1a1f,#0a1519);border:1px solid #213941;border-radius:15px;padding:18px}.history-kind{font-size:8px;letter-spacing:1.5px;color:#79f2a4;font-weight:900}.history-item h3{margin:6px 0 4px;font:800 16px Manrope}.history-item p{margin:0;color:#80979c;font-size:11px}.history-item time{display:block;color:#667e83;font-size:9px;white-space:nowrap}.history-score{text-align:right}.history-score strong{display:block;font:800 24px Manrope;color:#f4d35e}.history-score span{display:block;font-size:8px;letter-spacing:1px;color:#79f2a4;font-weight:800;margin:2px 0 6px}.plan-history{align-items:flex-start}
@media(max-width:700px){.history-summary{grid-template-columns:1fr}.history-item{align-items:flex-start;flex-direction:column}.history-score{text-align:left}.auth-card{padding:23px}}


/* FORMFIT AUTH/HISTORY V2 — UI ISOLATED */
.account-btn{
  border:1px solid #2d444b;
  background:#0b171c;
  color:#d9e8e8;
  border-radius:10px;
  padding:9px 13px;
  font:800 10px Manrope,sans-serif;
  letter-spacing:1.2px;
  cursor:pointer;
}
.account-btn:hover{border-color:#f4b942;color:#f4b942}

.auth-overlay{
  position:fixed;inset:0;z-index:10000;
  display:none;align-items:center;justify-content:center;
  background:rgba(3,8,11,.72);
  backdrop-filter:blur(10px);
}
.auth-overlay.open{display:flex}
.auth-card{
  position:relative;width:min(420px,calc(100vw - 32px));
  padding:28px;border:1px solid #263d45;border-radius:20px;
  background:linear-gradient(150deg,#0e1c22,#091318);
  box-shadow:0 28px 90px rgba(0,0,0,.5);
}
.auth-close{
  border:0;background:transparent;color:#91a4a7;
  font-size:25px;cursor:pointer;
}
.auth-card>.auth-close{position:absolute;right:14px;top:10px}
.auth-eyebrow{font-size:9px;letter-spacing:1.7px;color:#f4b942;font-weight:900}
.auth-card h2,.history-head h2{margin:8px 0 5px;color:#edf7f6}
.auth-card p{margin:0 0 18px;color:#8fa5a8;font-size:12px;line-height:1.5}
.auth-card label{display:block;margin:12px 0 6px;color:#9db0b2;font-size:10px;font-weight:800}
.auth-card input{
  width:100%;box-sizing:border-box;padding:12px 13px;
  border:1px solid #263d45;border-radius:10px;
  background:#071116;color:#eef8f7;outline:none;
}
.auth-card input:focus{border-color:#f4b942}
.auth-submit{width:100%;margin-top:17px}
.auth-message{min-height:18px;margin-top:10px;color:#f4b942;font-size:11px}
.auth-switch{
  margin-top:9px;border:0;background:transparent;color:#91f0ad;
  cursor:pointer;font-size:11px;
}
.history-drawer{
  position:fixed;right:0;top:0;bottom:0;z-index:9999;
  width:min(460px,100vw);padding:24px;box-sizing:border-box;
  background:#081318;border-left:1px solid #253b42;
  transform:translateX(102%);transition:transform .22s ease;
  box-shadow:-25px 0 80px rgba(0,0,0,.35);overflow:auto;
}
.history-drawer.open{transform:translateX(0)}
.history-head{display:flex;justify-content:space-between;align-items:flex-start}
.history-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:18px 0}
.history-stat{
  padding:12px 8px;border:1px solid #20353c;border-radius:11px;
  background:#0c1a20;text-align:center;
}
.history-stat span{display:block;font-size:8px;color:#71898d;letter-spacing:1px}
.history-stat strong{display:block;margin-top:5px;font-size:19px;color:#f0f8f7}
.history-list{display:grid;gap:9px}
.history-item{
  padding:13px;border:1px solid #20353c;border-radius:12px;background:#0c1a20;
}
.history-item-head{display:flex;justify-content:space-between;gap:10px}
.history-item strong{color:#eaf5f4;font-size:13px}
.history-item time{color:#71898d;font-size:9px}
.history-item-meta{display:flex;gap:12px;margin-top:8px;color:#9db0b2;font-size:10px}
.history-empty{padding:30px 10px;text-align:center;color:#71898d;font-size:12px}


/* ============================================================
   FORMFIT PRO ACCOUNT UX — AUTH ONLY
   Does not alter pose/pipes/camera styles.
   ============================================================ */
.auth-overlay.visible {
  display: grid !important;
  z-index: 10000;
}
.auth-card {
  position: relative;
  overflow: hidden;
}
.auth-card::before {
  content: "";
  position: absolute;
  inset: 0 0 auto 0;
  height: 2px;
  background: linear-gradient(90deg, transparent, #79f2a4, #f4d35e, transparent);
  opacity: .9;
}
.auth-card input {
  transition: border-color .18s ease, box-shadow .18s ease, transform .18s ease;
}
.auth-card input:focus {
  transform: translateY(-1px);
}
.auth-tab,
.auth-submit,
.account-btn,
.logout-btn {
  transition: transform .16s ease, border-color .16s ease, background .16s ease, color .16s ease, opacity .16s ease;
}
.auth-tab:active,
.auth-submit:active,
.account-btn:active {
  transform: translateY(1px);
}
.auth-submit:disabled {
  opacity: .65;
  cursor: wait;
}
.auth-error:empty {
  visibility: hidden;
}
.account-btn {
  cursor: pointer;
}
.account-card {
  cursor: pointer;
}


/* ============================================================
   FORMFIT — PERSONALIZED INDIAN MEAL PLAN
   UI-only additions. Does not touch form checker rendering.
   ============================================================ */
.meal-head{margin-bottom:20px}
.meal-form-card{
  background:linear-gradient(145deg,rgba(15,31,37,.94),rgba(8,20,25,.94));
  border:1px solid #25434a;
  border-radius:22px;
  padding:26px;
  max-width:1050px;
  box-shadow:0 20px 70px rgba(0,0,0,.24);
  backdrop-filter:blur(14px);
}
.meal-form-grid{display:grid;grid-template-columns:1fr 1fr;gap:15px}
.meal-field label,.meal-choice-section>label{
  display:block;font-size:10px;letter-spacing:1.8px;color:#8fa5aa;font-weight:800;margin-bottom:9px
}
.meal-field input{
  background:rgba(5,17,22,.8);
  border:1px solid #29474f;
  border-radius:13px;
  padding:14px 15px;
  font-size:16px;
}
.meal-field small{display:block;color:#667f85;font-size:10px;margin-top:7px}
.meal-choice-section{margin-top:23px}
.meal-choice-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:10px}
.meal-preference-grid{grid-template-columns:repeat(3,1fr)}
.meal-choice{
  min-height:78px;
  border:1px solid #29444b;
  background:linear-gradient(145deg,rgba(15,34,40,.88),rgba(7,19,24,.9));
  color:#9db0b4;
  border-radius:15px;
  padding:13px;
  text-align:left;
  cursor:pointer;
  transition:.2s ease;
  box-shadow:inset 0 1px rgba(255,255,255,.025);
}
.meal-choice strong{display:block;color:#eaf4f2;font:800 14px Manrope;margin-bottom:5px}
.meal-choice span{display:block;font-size:10px;line-height:1.4;color:#789095}
.meal-choice:hover{transform:translateY(-2px);border-color:#42715e}
.meal-choice.selected{
  border-color:var(--accent);
  background:linear-gradient(145deg,rgba(55,160,110,.26),rgba(10,38,30,.88));
  box-shadow:0 0 0 1px rgba(121,242,164,.12),0 12px 30px rgba(24,90,62,.18);
}
.meal-choice.selected strong{color:var(--accent)}
.meal-generate-btn{margin-top:24px;max-width:410px}
.meal-plan-result{display:grid;gap:14px;margin-top:25px}
.meal-profile-card,.daily-summary-card,.meal-disclaimer{
  background:var(--panel);
  border:1px solid var(--line);
  border-radius:18px;
}
.meal-profile-card{
  padding:20px 22px;
  display:flex;
  justify-content:space-between;
  gap:18px;
  align-items:center;
}
.meal-profile-card h3{margin:6px 0 0;font:800 21px Manrope}
.meal-profile-stats{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:8px}
.meal-profile-stats span{
  background:#11252b;border:1px solid #28434a;border-radius:999px;padding:8px 11px;color:#789095;font-size:10px
}
.meal-profile-stats b{color:var(--accent);margin-right:4px}
.meal-plan-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:13px}
 .meal-card{
  background:linear-gradient(180deg,#0d1c21,#081419);
  border:1px solid #27434a;
  border-radius:19px;
  padding:19px;
  box-shadow:0 12px 34px rgba(0,0,0,.14),inset 0 1px rgba(255,255,255,.025);
}
.meal-card-head{display:flex;justify-content:space-between;align-items:flex-start;gap:14px;margin-bottom:8px}
.meal-number{display:inline-flex;align-items:center;font-size:9px;letter-spacing:1.7px;color:var(--accent);font-weight:900;text-transform:uppercase}
.meal-card h3{margin:5px 0 0;font:800 18px Manrope;line-height:1.2}
.meal-kcal{font-size:10px;font-weight:900;color:var(--yellow);background:rgba(88,69,12,.28);border:1px solid #5a4b1d;padding:8px 10px;border-radius:999px;white-space:nowrap;box-shadow:inset 0 1px rgba(255,255,255,.04)}
.meal-items{margin-top:12px}
.meal-item{
  display:grid;grid-template-columns:minmax(0,1fr);gap:10px;
  padding:15px 0;border-top:1px solid #1e343a
}
.meal-item:first-child{border-top:0}
.meal-item strong{display:block;font-size:13px;color:#edf5f3;line-height:1.3}
.meal-item small{display:block;color:#71888d;font-size:10px;margin-top:4px}
.meal-item-macros{display:flex;align-items:center;gap:6px;flex-wrap:wrap;justify-content:flex-start;max-width:none}
.meal-item-macros b{font-size:10px;color:#e2ecea;background:#11252b;border:1px solid #1e3a41;padding:6px 8px;border-radius:7px}
.meal-item-macros span{font-size:9px;color:#9ab0b3;background:#0e2228;border:1px solid #1b353c;padding:5px 7px;border-radius:6px}
.meal-total{
  display:flex;gap:12px;align-items:center;border-top:1px solid #294149;margin-top:5px;padding-top:12px;font-size:10px;color:#80969b
}
.meal-total b{color:var(--yellow);margin-left:auto}
.daily-summary-card{padding:21px}
.daily-summary-card h3{margin:5px 0;font:800 20px Manrope}
.daily-summary-card p{color:var(--muted);font-size:11px;margin:0;line-height:1.5}
.daily-summary-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:17px}
.daily-summary-grid div{background:#0a171c;border:1px solid #1e363d;border-radius:12px;padding:14px;text-align:center}
.daily-summary-grid span{display:block;color:#71888d;font-size:9px;letter-spacing:.7px}
.daily-summary-grid strong{display:block;color:#fff;font:800 18px Manrope;margin-top:8px}
.meal-disclaimer{padding:13px 16px;color:#7f969b;font-size:10px;line-height:1.6}
@media(max-width:900px){
  .meal-choice-grid{grid-template-columns:repeat(2,1fr)}
  .meal-plan-grid{grid-template-columns:1fr}
  .meal-profile-card{flex-direction:column;align-items:flex-start}
  .meal-profile-stats{justify-content:flex-start}
}
@media(max-width:700px){
  .meal-form-grid,.meal-choice-grid,.meal-preference-grid{grid-template-columns:1fr}
  .daily-summary-grid{grid-template-columns:1fr 1fr}
  .meal-item{display:block}
  .meal-item-macros{justify-content:flex-start;margin-top:8px}
}


/* PRE-MAPPED REFERENCE DEMO — isolated visual layer */
.premapped-demo-card{
  width:100%;
  padding:12px;
  border:1px solid #203a41;
  border-radius:16px;
  background:linear-gradient(145deg,#0c1a1f,#0a1519);
  box-shadow:0 14px 32px rgba(0,0,0,.16);
}
.premapped-demo-head{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:8px;
  margin-bottom:9px;
}
.premapped-demo-head > div{min-width:0}
.premapped-demo-head span:first-child{
  display:block;
  font-size:8px;
  letter-spacing:1.5px;
  color:#87a2a7;
  font-weight:800;
  margin-bottom:4px;
}
.premapped-demo-head strong{
  display:block;
  color:var(--text);
  font:800 12px/1.3 Manrope;
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis;
}
.premapped-demo-badge{
  flex:0 0 auto;
  color:var(--accent);
  border:1px solid #24563c;
  border-radius:999px;
  padding:4px 7px;
  font-size:7px;
  font-weight:800;
  letter-spacing:.8px;
}
.premapped-demo-frame{
  position:relative;
  width:100%;
  aspect-ratio:9/16;
  min-height:260px;
  max-height:430px;
  overflow:hidden;
  border:1px solid #1d343b;
  border-radius:11px;
  background:#03090c;
}
.premapped-demo-iframe{
  display:block;
  width:100%;
  height:100%;
  min-height:100%;
  border:0;
  background:#03090c;
}
.premapped-demo-meta{
  min-height:12px;
  margin-top:8px;
  color:#728c92;
  font-size:8px;
  line-height:1.35;
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis;
}
@media (max-width:1050px){
  .premapped-demo-frame{max-height:390px}
}
@media (max-width:700px){
  .premapped-demo-frame{
    min-height:230px;
    max-height:370px;
  }
}

/* ============================================================
   FORMFIT — SMART DIET MEMORY + EDITOR
   Isolated to Meal Plan; does not affect Form Checker visuals.
   ============================================================ */
.diet-memory-card,.saved-diets-panel{
  background:linear-gradient(145deg,rgba(13,29,35,.92),rgba(7,18,23,.94));
  border:1px solid #27434a;border-radius:18px;padding:20px;margin-top:20px
}
.diet-memory-head,.saved-diets-head{display:flex;justify-content:space-between;align-items:flex-start;gap:16px}
.diet-memory-head h3,.saved-diets-head h3{margin:6px 0 0;font:800 18px Manrope}
.diet-memory-badge{font-size:9px;letter-spacing:1px;text-transform:uppercase;padding:7px 9px;border:1px solid #31534a;border-radius:999px;color:var(--accent);background:#0d211b;white-space:nowrap}
.diet-memory-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;margin-top:18px}
.diet-memory-grid .meal-field{margin:0}
 .meal-card-actions{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin-top:4px}
.meal-action-btn,.meal-qty-apply,.ghost-btn,.saved-diet-open,.saved-diet-delete{
  min-height:39px;border:1px solid #2c4b53;background:linear-gradient(180deg,#10232a,#0b1b21);color:#b9c9cb;border-radius:10px;padding:9px 10px;font-size:10px;font-weight:900;cursor:pointer;transition:transform .18s ease,border-color .18s ease,background .18s ease,color .18s ease;letter-spacing:.1px
}
.meal-action-btn:hover,.meal-qty-apply:hover,.ghost-btn:hover,.saved-diet-open:hover,.saved-diet-delete:hover{transform:translateY(-1px);border-color:#4d796a;color:#fff}
.meal-action-btn.favorite{color:#b7d7cb}
.meal-action-btn.favorite.active{border-color:var(--accent);color:var(--accent);background:linear-gradient(180deg,#123629,#0d241d);box-shadow:0 0 0 1px rgba(121,242,164,.08)}
.meal-action-btn.dislike{color:#bfc5c7}
.meal-action-btn.dislike.active{border-color:#b45b6b;color:#ff9daf;background:#2a151b}
.meal-card-actions .meal-action-btn:last-child{border-color:#365763;color:#d2e3e4}
.meal-edit-row{display:grid;grid-template-columns:auto 90px auto auto;align-items:center;gap:8px;margin-top:11px;padding:10px 11px;background:#0a1a20;border:1px solid #1c353c;border-radius:11px}
.meal-qty-input{width:90px;box-sizing:border-box;background:#07151a;border:1px solid #31515a;border-radius:8px;color:#eaf4f2;padding:9px 9px;font-size:11px;font-weight:700;outline:none}
.meal-qty-input:focus{border-color:#5f8f7c;box-shadow:0 0 0 3px rgba(95,143,124,.1)}
.meal-edit-row label{font-size:9px;letter-spacing:1px;color:#7f989d;text-transform:uppercase;font-weight:900}
.meal-edit-row > span{font-size:9px;color:#789095!important;white-space:nowrap}
.meal-edit-row .meal-qty-apply{min-height:36px;padding:7px 11px}
.meal-feedback-box{margin-top:18px;border-top:1px solid #203a41;padding-top:16px}
.meal-feedback-box label{display:block;font-size:9px;letter-spacing:1px;color:#7f969b;text-transform:uppercase;font-weight:800;margin-bottom:8px}
.meal-feedback-row{display:flex;gap:9px;align-items:center}
.meal-feedback-row textarea{flex:1;min-height:72px;resize:vertical;background:#08161b;border:1px solid #29444b;border-radius:10px;color:#eaf4f2;padding:10px;font:500 11px Manrope}
.meal-save-bar{display:flex;justify-content:space-between;gap:12px;align-items:center;margin-top:16px;flex-wrap:wrap}
.meal-save-bar small{color:#71888d;font-size:10px}
.saved-diets-panel{margin-top:20px}
.saved-diet-list{display:grid;gap:9px;margin-top:14px}
.saved-diet-item{display:flex;justify-content:space-between;gap:12px;align-items:center;padding:12px 13px;background:#0a171c;border:1px solid #1f383f;border-radius:12px}
.saved-diet-item strong{display:block;font-size:12px;color:#edf5f3}
.saved-diet-item small{display:block;margin-top:3px;color:#71888d;font-size:9px}
.saved-diet-actions{display:flex;gap:7px;flex-wrap:wrap}
.saved-diet-empty{padding:14px;color:#71888d;font-size:11px;border:1px dashed #29444b;border-radius:12px}
@media(max-width:700px){.diet-memory-grid{grid-template-columns:1fr}.meal-feedback-row{flex-direction:column;align-items:stretch}.saved-diet-item{align-items:flex-start;flex-direction:column}.saved-diet-actions{width:100%}}

/* ============================================================
   AI WORKOUT INTELLIGENCE
   ============================================================ */
.workout-memory-banner,
.workout-save-card,
.workout-feedback-box,
.saved-workout-section {
  margin-top: 16px;
  padding: 18px;
  border: 1px solid rgba(117, 255, 178, 0.14);
  border-radius: 16px;
  background: rgba(7, 25, 29, 0.72);
}

.workout-memory-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
}

.workout-memory-banner strong {
  display: block;
  margin-top: 5px;
  font-size: 15px;
}

.workout-memory-banner small,
.workout-save-card p,
.saved-workout-item small {
  color: var(--muted);
}

.workout-day-head,
.section-mini-head,
.workout-save-actions,
.workout-feedback-actions,
.saved-workout-actions,
.workout-action-row {
  display: flex;
  align-items: center;
  gap: 8px;
}

.workout-day-head,
.section-mini-head,
.workout-save-card {
  justify-content: space-between;
}

.workout-plan-ex {
  display: grid;
  grid-template-columns: minmax(180px, 1fr) auto;
  gap: 10px 14px;
  align-items: center;
}

.workout-plan-main {
  display: flex;
  align-items: flex-start;
  gap: 10px;
}

.workout-order {
  min-width: 22px;
  color: var(--accent);
  font-weight: 800;
}

.workout-prescription {
  grid-column: 1 / -1;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px;
}

.workout-prescription label {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  color: var(--muted);
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: .08em;
}

.workout-prescription input {
  width: 72px;
  min-height: 34px;
  border: 1px solid rgba(117, 255, 178, 0.14);
  border-radius: 9px;
  background: #0b1c20;
  color: #fff;
  padding: 0 9px;
}

.workout-action-row {
  grid-column: 1 / -1;
  flex-wrap: wrap;
}

.workout-action-btn {
  border: 1px solid rgba(117, 255, 178, 0.15);
  border-radius: 999px;
  background: #0a1d21;
  color: #c2d4d6;
  padding: 8px 11px;
  font-size: 11px;
  cursor: pointer;
}

.workout-action-btn:hover,
.workout-action-btn.active {
  border-color: rgba(117, 255, 178, 0.5);
  color: var(--accent);
  background: rgba(117, 255, 178, 0.08);
}

.workout-action-btn:focus-visible,
.workout-prescription input:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
}

.workout-save-card {
  display: flex;
  gap: 18px;
}

.workout-save-actions {
  flex-wrap: wrap;
  justify-content: flex-end;
}

.workout-feedback-box textarea {
  width: 100%;
  min-height: 86px;
  resize: vertical;
  margin-top: 10px;
  border: 1px solid rgba(117, 255, 178, 0.14);
  border-radius: 12px;
  background: #08181c;
  color: #fff;
  padding: 12px;
  font: inherit;
}

.workout-feedback-actions {
  justify-content: flex-end;
  margin-top: 10px;
}

.saved-workout-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 12px 0;
  border-top: 1px solid rgba(117, 255, 178, 0.08);
}

.saved-workout-item:first-child {
  border-top: 0;
}

.saved-workout-item strong,
.saved-workout-item small {
  display: block;
}

.saved-workout-empty {
  padding: 14px 0 2px;
  color: var(--muted);
  font-size: 13px;
}

@media (max-width: 850px) {
  .workout-memory-banner,
  .workout-save-card,
  .saved-workout-item {
    flex-direction: column;
    align-items: flex-start;
  }

  .workout-save-actions,
  .saved-workout-actions {
    justify-content: flex-start;
  }

  .workout-plan-ex {
    grid-template-columns: 1fr;
  }

  .workout-plan-ex > .badge {
    justify-self: start;
  }
}



/* ============================================================
   FORMFIT — WINTER ARC
   UI-only seasonal planning layer.
   ============================================================ */
.winter-arc-hero{display:grid;grid-template-columns:minmax(0,1fr) 170px;gap:18px;align-items:stretch;background:linear-gradient(135deg,#0c191d,#132c2d);border:1px solid #29464a;border-radius:20px;padding:30px;box-shadow:0 18px 60px rgba(0,0,0,.2)}
.winter-arc-hero h2{font:800 42px/1.04 Manrope;margin:14px 0;color:#fff;letter-spacing:-1px}.winter-arc-hero h2 em{font-style:normal;color:var(--accent)}.winter-arc-hero p{max-width:760px;color:#9fb1b5;line-height:1.7}.winter-arc-badge{border:1px solid #35575b;border-radius:18px;background:#081216;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center}.winter-arc-badge span{font-size:9px;letter-spacing:2px;color:#789095;font-weight:800}.winter-arc-badge strong{font:800 48px/1 Manrope;color:var(--accent);margin:10px 0 3px}.winter-arc-badge small{font-size:11px;color:#9fb1b5}.winter-arc-grid{display:grid;grid-template-columns:1.5fr 1fr 1fr;gap:13px;margin-top:14px}.winter-info-card{background:var(--panel);border:1px solid var(--line);border-radius:17px;padding:22px}.winter-info-card h3{margin:8px 0 10px;font:800 21px Manrope}.winter-info-card p{color:var(--muted);line-height:1.65;font-size:13px}.winter-principles{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:18px}.winter-principles div{background:#0b171c;border:1px solid #20363d;border-radius:12px;padding:13px}.winter-principles b{display:block;color:var(--text);margin-bottom:5px}.winter-principles span{color:#81969a;font-size:12px;line-height:1.45}.winter-list{margin:14px 0 0;padding:0 0 0 18px;color:#a7b8bb;font-size:12px;line-height:1.8}.winter-list.good li::marker{color:var(--accent)}.winter-list.bad li::marker{color:#ff6e6e}.winter-builder{margin-top:14px;background:var(--panel);border:1px solid var(--line);border-radius:18px;padding:25px}.winter-form-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.winter-equipment-block{margin-top:20px}.winter-habits{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin:20px 0;padding:16px;border:1px solid #20363d;border-radius:13px;background:#0b171c}.winter-habits>div{grid-column:1/-1;margin-bottom:2px}.winter-habits>div b{display:block}.winter-habits>div span{font-size:11px;color:#71888d}.winter-habits label{font-size:12px;color:#9fb1b5}.winter-habits input{width:auto;margin-right:7px}.winter-result{margin-top:14px;display:grid;gap:12px}.winter-plan-head{display:flex;justify-content:space-between;gap:18px;align-items:center;background:var(--panel);border:1px solid var(--line);border-radius:17px;padding:22px}.winter-plan-head h3{font:800 24px Manrope;margin:7px 0}.winter-plan-head p{color:var(--muted);font-size:12px}.winter-score-box{min-width:105px;text-align:center;border:1px solid #2b4b50;background:#0a1519;border-radius:13px;padding:12px}.winter-score-box span{font-size:9px;letter-spacing:1.3px;color:#789095}.winter-score-box strong{display:block;font:800 30px Manrope;color:var(--accent);margin-top:5px}.winter-output-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:13px}.winter-output-card{background:var(--panel);border:1px solid var(--line);border-radius:17px;padding:20px}.winter-output-card h4{font:800 18px Manrope;margin:8px 0}.winter-output-card p{font-size:12px;line-height:1.65;color:var(--muted);min-height:74px}.winter-arc-note{border:1px solid #3c4330;background:#171a10;border-radius:12px;padding:13px 15px;color:#b9ba9d;font-size:12px;line-height:1.6}.winter-arc-note strong{color:#e7e8c9}
@media(max-width:1000px){.winter-arc-grid,.winter-output-grid{grid-template-columns:1fr}.winter-form-grid{grid-template-columns:1fr 1fr}.winter-arc-hero{grid-template-columns:1fr 130px}}
@media(max-width:700px){.winter-arc-hero{grid-template-columns:1fr;padding:22px}.winter-arc-hero h2{font-size:34px}.winter-arc-badge{min-height:130px}.winter-principles,.winter-form-grid,.winter-habits{grid-template-columns:1fr}.winter-habits>div{grid-column:auto}.winter-plan-head{align-items:flex-start;flex-direction:column}}

/* ============================================================
   FORMFIT MOBILE V1
   UI-only responsive layer.
   IMPORTANT: no form/pose/camera JavaScript is changed here.
   ============================================================ */

@media (max-width: 700px) {
  html, body {
    width: 100%;
    min-width: 0;
    overflow-x: hidden;
  }

  body {
    padding-bottom: 68px;
  }

  .app-shell {
    min-height: 100vh;
    display: block;
  }

  /* Compact bottom navigation; existing data-view buttons keep working. */
  .sidebar {
    width: 100%;
    height: 64px;
    padding: 6px 8px;
    inset: auto 0 0 0;
    border-right: 0;
    border-top: 1px solid var(--line);
    background: rgba(5, 14, 18, .96);
    backdrop-filter: blur(14px);
    display: block;
    z-index: 100;
  }

  .sidebar .brand,
  .sidebar .sidebar-card,
  .sidebar .account-card,
  .sidebar .sidebar-footer {
    display: none;
  }

  .sidebar nav {
    height: 100%;
    display: flex;
    align-items: stretch;
    gap: 4px;
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: none;
  }

  .sidebar nav::-webkit-scrollbar {
    display: none;
  }

  .nav-item {
    flex: 0 0 56px;
    min-width: 56px;
    height: 50px;
    padding: 0;
    justify-content: center;
    text-align: center;
    border-radius: 10px;
    font-size: 19px;
  }

  .nav-item span {
    display: none;
  }

  .nav-item.active {
    box-shadow: inset 0 3px var(--accent);
  }

  .main {
    width: 100%;
    margin-left: 0;
    padding: 14px 12px 28px;
  }

  .topbar {
    margin-bottom: 18px;
    padding-bottom: 16px;
    align-items: center;
  }

  .topbar h1 {
    font-size: 21px;
    line-height: 1.15;
  }

  .top-actions {
    display: none;
  }

  .account-btn {
    flex: 0 0 auto;
    padding: 8px 10px;
    font-size: 9px;
  }

  .hero {
    min-height: 0;
    display: block;
    border-radius: 19px;
  }

  .hero-copy {
    padding: 25px 20px;
  }

  .hero h2 {
    font-size: 34px;
    line-height: 1.05;
  }

  .hero p {
    font-size: 13px;
  }

  .hero-actions {
    flex-direction: column;
  }

  .hero-actions .big {
    width: 100%;
  }

  .hero-visual {
    min-height: 255px;
  }

  .pose-card {
    transform: scale(.82);
  }

  .stats-row {
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin-bottom: 25px;
  }

  .stat-card {
    padding: 13px;
  }

  .stat-card strong {
    font-size: 22px;
  }

  .feature-grid,
  .exercise-grid,
  .form-checker,
  .form-row {
    grid-template-columns: 1fr;
  }

  /* Form checker: camera first, then coaching, then metrics/demo. */
  #formView .form-topline {
    align-items: flex-start;
  }

  #formView .form-title-wrap {
    display: block;
  }

  #formView .form-title-wrap h2 {
    font-size: 27px;
    line-height: 1.08;
    margin-top: 7px;
  }

  #formView .run-pill {
    padding: 8px 10px;
    font-size: 9px;
  }

  #formView .form-session-bar {
    padding: 11px 12px;
    font-size: 11px;
    line-height: 1.4;
  }

  #formView .form-main-grid {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-height: 0;
  }

  #formView .form-camera-card {
    order: 1;
    min-height: 0;
    width: 100%;
    border-radius: 16px;
  }

  #formView .form-camera-card .camera-placeholder {
    min-height: 0;
    height: auto;
    aspect-ratio: 3 / 4;
    padding: 20px 14px;
  }

  #formView .form-camera-card .camera-placeholder video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #formView .form-coaching-card {
    order: 2;
    min-height: 0;
    padding: 15px;
    border-radius: 16px;
  }

  #formView .form-left-metrics {
    order: 3;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 9px;
  }

  #formView .form-left-metrics .premapped-demo-card,
  #formView .form-left-metrics .guide-card {
    grid-column: 1 / -1;
  }

  #formView .form-left-metrics .metric-card {
    min-height: 112px;
    padding: 12px 8px;
  }

  #formView .form-left-metrics .score-card {
    min-height: 145px;
  }

  #formView .form-left-metrics .score-ring {
    width: 76px;
    height: 76px;
  }

  #formView .premapped-demo-frame {
    min-height: 250px;
    max-height: none;
    aspect-ratio: 9 / 16;
  }

  #formView .premapped-demo-card {
    padding: 10px;
  }

  #formView .metrics-grid {
    grid-template-columns: 1fr 1fr;
  }

  #formView .tip-strip {
    align-items: flex-start;
  }

  #formView .tip-strip b {
    font-size: 11px;
  }

  .choice-grid,
  .meal-choice-grid {
    grid-template-columns: 1fr 1fr;
  }

  .winter-arc-hero {
    padding: 20px;
  }

  .winter-arc-hero h2 {
    font-size: 31px;
  }

  input,
  select,
  textarea {
    max-width: 100%;
  }
}

@media (max-width: 390px) {
  .main {
    padding-left: 9px;
    padding-right: 9px;
  }

  .nav-item {
    flex-basis: 52px;
    min-width: 52px;
  }

  .stats-row,
  #formView .form-left-metrics,
  #formView .metrics-grid {
    grid-template-columns: 1fr;
  }

  #formView .form-left-metrics .premapped-demo-card,
  #formView .form-left-metrics .guide-card {
    grid-column: auto;
  }

  .premapped-demo-frame {
    min-height: 225px;
  }
}


/* ============================================================
   FORMFIT MOBILE V2 — PROFESSIONAL PHONE UI
   UI ONLY. Desktop styles and app/pose/camera logic are untouched.
   ============================================================ */
@media (max-width: 700px) {
  :root {
    --mobile-gutter: 14px;
    --mobile-radius: 18px;
    --mobile-nav-h: 72px;
  }

  html {
    scroll-behavior: smooth;
    -webkit-text-size-adjust: 100%;
  }

  body {
    padding-bottom: calc(var(--mobile-nav-h) + env(safe-area-inset-bottom));
    background: #050d10;
  }

  .app-shell {
    width: 100%;
    min-height: 100dvh;
  }

  .main {
    width: 100%;
    padding: 14px var(--mobile-gutter) 34px;
  }

  /* ---------- App header ---------- */
  .topbar {
    position: relative;
    display: flex;
    min-height: 54px;
    margin: 0 0 14px;
    padding: 4px 0 13px;
    border-bottom: 1px solid rgba(104, 140, 145, .12);
  }

  .topbar > div:first-child {
    min-width: 0;
    padding-right: 72px;
  }

  .topbar .eyebrow {
    display: block;
    margin-bottom: 5px;
    font-size: 8px;
    letter-spacing: 1.7px;
  }

  .topbar h1 {
    max-width: 250px;
    margin: 0;
    font: 800 20px/1.12 Manrope, Inter, sans-serif;
    letter-spacing: -.35px;
  }

  .account-btn {
    position: absolute;
    top: 0;
    right: 0;
    height: 34px;
    padding: 0 11px;
    border-radius: 999px;
    font-size: 8px;
    letter-spacing: 1px;
  }

  /* ---------- Bottom app navigation ---------- */
  .sidebar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: var(--mobile-nav-h);
    padding: 6px 7px calc(6px + env(safe-area-inset-bottom));
    border: 0;
    border-top: 1px solid rgba(117, 255, 178, .12);
    background: rgba(4, 12, 15, .92);
    box-shadow: 0 -14px 38px rgba(0, 0, 0, .28);
    backdrop-filter: blur(22px) saturate(125%);
    -webkit-backdrop-filter: blur(22px) saturate(125%);
  }

  .sidebar nav {
    width: 100%;
    height: 100%;
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 3px;
    overflow: visible;
  }

  .nav-item {
    width: 100%;
    min-width: 0;
    height: 58px;
    min-height: 58px;
    padding: 6px 2px 5px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3px;
    border: 1px solid transparent;
    border-radius: 15px;
    color: #70868b;
    font-size: 17px;
    line-height: 1;
    background: transparent;
    transition: background .18s ease, color .18s ease, border-color .18s ease, transform .18s ease;
  }

  .nav-item span {
    display: block;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font: 600 7px/1.1 Inter, sans-serif;
    letter-spacing: .15px;
  }

  .nav-item.active {
    color: var(--accent);
    background: rgba(121, 242, 164, .075);
    border-color: rgba(121, 242, 164, .12);
    box-shadow: inset 0 2px 0 var(--accent), 0 4px 16px rgba(0, 0, 0, .12);
  }

  .nav-item:active {
    transform: scale(.95);
  }

  /* ---------- Shared mobile sections/cards ---------- */
  .section-head {
    margin-bottom: 14px;
  }

  .section-head h2 {
    font-size: 25px;
    line-height: 1.08;
    letter-spacing: -.45px;
  }

  .section-head p {
    margin-top: 8px;
    font-size: 12px;
    line-height: 1.55;
  }

  .feature-grid,
  .exercise-grid,
  .choice-grid,
  .meal-choice-grid {
    gap: 10px;
  }

  .exercise-card,
  .feature-card,
  .day-card,
  .history-card {
    border-radius: var(--mobile-radius);
  }

  .primary-btn,
  .secondary-btn,
  .ghost-btn {
    min-height: 44px;
    border-radius: 12px;
  }

  input,
  select,
  textarea {
    min-height: 44px;
    border-radius: 12px;
    font-size: 14px;
  }

  /* ---------- Home ---------- */
  .hero {
    width: 100%;
    border-radius: 21px;
    overflow: hidden;
    box-shadow: 0 18px 50px rgba(0, 0, 0, .18);
  }

  .hero-copy {
    padding: 24px 20px 22px;
  }

  .hero h2 {
    margin-top: 13px;
    font-size: 34px;
    line-height: 1.03;
    letter-spacing: -1px;
  }

  .hero p {
    margin-top: 12px;
    font-size: 12px;
    line-height: 1.65;
  }

  .hero-actions {
    gap: 8px;
    margin-top: 18px;
  }

  .hero-actions .big {
    min-height: 47px;
  }

  .hero-visual {
    min-height: 215px;
  }

  .stats-row {
    gap: 9px;
    margin: 12px 0 18px;
  }

  .stat-card {
    min-height: 94px;
    padding: 13px 10px;
    border-radius: 15px;
  }

  .stat-card strong {
    font-size: 21px;
  }

  /* ---------- Library ---------- */
  .library-head {
    display: block;
  }

  .library-tools {
    width: 100%;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 112px;
    gap: 8px;
    margin-top: 12px;
  }

  .exercise-grid {
    grid-template-columns: 1fr;
  }

  .exercise-card {
    padding: 16px;
  }

  /* ---------- Form checker ---------- */
  #formView .form-dashboard {
    min-height: 0;
    gap: 10px;
  }

  #formView .form-topline {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }

  #formView .form-title-wrap {
    min-width: 0;
    display: block;
    flex: 1 1 auto;
  }

  #formView .form-title-wrap .eyebrow {
    font-size: 8px;
    letter-spacing: 1.6px;
  }

  #formView .form-title-wrap h2 {
    max-width: 100%;
    margin: 6px 0 0;
    padding: 0;
    min-height: 0;
    display: block;
    overflow: hidden;
    border: 0;
    background: none;
    box-shadow: none;
    color: #fff;
    font: 800 24px/1.08 Manrope, Inter, sans-serif;
    letter-spacing: -.45px;
    text-overflow: ellipsis;
    white-space: nowrap;
    text-shadow: none;
  }

  #formView .run-pill {
    flex: 0 0 auto;
    padding: 7px 9px;
    font-size: 8px;
    letter-spacing: .55px;
  }

  #formView .run-pill span {
    width: 7px;
    height: 7px;
    margin-right: 5px;
  }

  #formView .form-session-bar {
    margin: 0;
    padding: 10px 12px;
    border-radius: 12px;
    font-size: 10px;
    line-height: 1.35;
    color: #cfe0de;
  }

  #formView .form-main-grid {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-height: 0;
  }

  /* Camera is deliberately the visual priority on phones. */
  #formView .form-camera-card {
    order: 1;
    width: 100%;
    min-height: 0;
    border-radius: 19px;
    box-shadow: 0 16px 42px rgba(0, 0, 0, .26);
  }

  #formView .form-camera-card .camera-placeholder {
    width: 100%;
    min-height: 0;
    height: auto;
    aspect-ratio: 4 / 5;
    padding: 18px;
  }

  #formView .form-camera-card .camera-placeholder video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #formView .camera-placeholder h3 {
    font-size: 18px;
  }

  #formView .camera-placeholder p {
    max-width: 300px;
    margin: 0 0 4px;
    font-size: 11px;
    line-height: 1.55;
  }

  #formView .camera-placeholder .primary-btn {
    min-width: 150px;
  }

  /* Coaching becomes a compact, readable action card. */
  #formView .form-coaching-card {
    order: 2;
    min-height: 0;
    padding: 14px;
    border-radius: 18px;
    box-shadow: 0 14px 38px rgba(0, 0, 0, .18);
  }

  #formView .reps-card {
    min-height: 132px;
    padding: 15px;
    border-radius: 15px;
  }

  #formView .reps-card-head span:first-child {
    font-size: 9px;
    letter-spacing: 1.6px;
  }

  #formView .reps-card > strong {
    font-size: 52px;
    line-height: .95;
    margin: 11px 0 7px;
  }

  #formView .reps-card > em {
    font-size: 9px;
  }

  #formView .panel-eyebrow {
    margin: 14px 0 8px;
    font-size: 9px;
  }

  #formView .coach-status {
    margin: 0 0 9px;
    padding: 11px 12px;
    border-radius: 11px;
    font-size: 13px;
  }

  #formView .feedback-row {
    gap: 9px;
    padding: 11px 2px;
    font-size: 11px;
  }

  #formView .form-coaching-card .full {
    margin-top: 10px;
    width: 100%;
  }

  #formView .mini-session-stats {
    margin-top: 12px;
    gap: 8px;
  }

  #formView .mini-session-stats > div {
    padding: 10px 8px;
    border-radius: 11px;
  }

  /* Metrics/demo follow coaching instead of competing with camera. */
  #formView .form-left-metrics {
    order: 3;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 9px;
  }

  #formView .form-left-metrics .metric-card {
    min-height: 104px;
    padding: 12px 8px;
    border-radius: 15px;
  }

  #formView .form-left-metrics .score-card {
    min-height: 130px;
  }

  #formView .form-left-metrics .score-ring {
    width: 68px;
    height: 68px;
    margin: 6px 0 2px;
  }

  #formView .form-left-metrics .metric-card > strong {
    font-size: 25px;
  }

  #formView .form-left-metrics .premapped-demo-card,
  #formView .form-left-metrics .guide-card {
    grid-column: 1 / -1;
  }

  #formView .premapped-demo-card {
    padding: 10px;
    border-radius: 16px;
  }

  #formView .premapped-demo-head {
    gap: 8px;
  }

  #formView .premapped-demo-frame {
    min-height: 0;
    height: auto;
    aspect-ratio: 16 / 10;
    max-height: none;
    border-radius: 12px;
  }

  #formView .premapped-demo-iframe {
    width: 100%;
    height: 100%;
  }

  #formView .tip-strip {
    min-height: 0;
    padding: 10px 11px;
    gap: 8px;
    border-radius: 12px;
    font-size: 10px;
    line-height: 1.45;
  }

  #formView .tip-icon {
    flex: 0 0 27px;
    width: 27px;
    height: 27px;
    border-radius: 8px;
  }

  #formView .bottom-status {
    padding: 9px 3px;
    font-size: 8px;
  }

  #formView .analysis-meter {
    width: 55px;
    margin: 0 4px;
  }

  /* ---------- Winter Arc / planner ---------- */
  .winter-arc-hero {
    padding: 18px;
    border-radius: 19px;
  }

  .winter-arc-hero h2 {
    margin-top: 10px;
    font-size: 30px;
  }

  .winter-arc-badge {
    min-height: 104px;
    border-radius: 15px;
  }

  .winter-builder,
  .winter-info-card,
  .winter-output-card {
    border-radius: 16px;
    padding: 16px;
  }

  /* ---------- Auth overlay ---------- */
  .auth-overlay {
    padding: 16px;
    align-items: flex-end;
  }

  .auth-card {
    width: 100%;
    max-height: calc(100dvh - 28px);
    overflow-y: auto;
    border-radius: 22px;
    padding: 22px 18px 18px;
  }
}

@media (max-width: 390px) {
  :root {
    --mobile-gutter: 11px;
  }

  .main {
    padding-top: 11px;
  }

  .topbar h1 {
    font-size: 19px;
  }

  .nav-item {
    height: 57px;
    min-height: 57px;
    border-radius: 13px;
    font-size: 16px;
  }

  .nav-item span {
    font-size: 6.5px;
  }

  #formView .form-title-wrap h2 {
    font-size: 22px;
  }

  #formView .run-pill {
    padding-left: 7px;
    padding-right: 7px;
  }

  #formView .form-camera-card .camera-placeholder {
    aspect-ratio: 3 / 4;
  }

  #formView .form-left-metrics {
    grid-template-columns: 1fr 1fr;
  }

  .library-tools {
    grid-template-columns: minmax(0, 1fr) 104px;
  }
}


/* =========================================================
   FORMFIT MOBILE ACCOUNT MODAL
   UI ONLY — scoped to the account sheet, no camera/exercise
   or form-checker styles are changed.
   ========================================================= */
.account-sheet-overlay {
  display: none;
}

@media (max-width: 768px) {
  .account-sheet-overlay {
    position: fixed !important;
    inset: 0 !important;
    z-index: 99990 !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    padding: 20px !important;
    box-sizing: border-box !important;
    background: rgba(2, 8, 10, 0.78) !important;
    backdrop-filter: blur(12px) saturate(115%) !important;
    -webkit-backdrop-filter: blur(12px) saturate(115%) !important;
    opacity: 0 !important;
    visibility: hidden !important;
    pointer-events: none !important;
    transition: opacity .2s ease, visibility .2s ease !important;
  }

  .account-sheet-overlay.open {
    opacity: 1 !important;
    visibility: visible !important;
    pointer-events: auto !important;
  }

  .account-sheet {
    width: min(100%, 390px) !important;
    max-height: min(82vh, 610px) !important;
    overflow: auto !important;
    margin: 0 !important;
    padding: 22px !important;
    box-sizing: border-box !important;
    border: 1px solid rgba(104, 235, 170, .18) !important;
    border-radius: 26px !important;
    background:
      linear-gradient(145deg, rgba(17, 31, 36, .98), rgba(7, 18, 22, .99)) !important;
    box-shadow:
      0 28px 80px rgba(0,0,0,.62),
      0 0 0 1px rgba(255,255,255,.025) inset !important;
    color: #eef6f7 !important;
    transform: translateY(12px) scale(.97) !important;
    transition: transform .22s cubic-bezier(.2,.8,.2,1) !important;
  }

  .account-sheet-overlay.open .account-sheet {
    transform: translateY(0) scale(1) !important;
  }

  .account-sheet-grabber {
    display: none !important;
  }

  .account-sheet-head {
    display: flex !important;
    align-items: flex-start !important;
    justify-content: space-between !important;
    gap: 16px !important;
    margin-bottom: 20px !important;
  }

  .account-sheet-eyebrow {
    display: block !important;
    margin-bottom: 5px !important;
    font-size: 10px !important;
    line-height: 1.2 !important;
    font-weight: 800 !important;
    letter-spacing: .2em !important;
    color: #7d9ca2 !important;
  }

  .account-sheet h2 {
    margin: 0 !important;
    font-size: 28px !important;
    line-height: 1.05 !important;
    letter-spacing: -.03em !important;
    color: #f4f8f8 !important;
  }

  .account-sheet-close {
    width: 38px !important;
    height: 38px !important;
    flex: 0 0 38px !important;
    padding: 0 !important;
    border: 1px solid rgba(255,255,255,.10) !important;
    border-radius: 50% !important;
    background: rgba(255,255,255,.055) !important;
    color: #a9bdc1 !important;
    font-size: 23px !important;
    line-height: 1 !important;
    cursor: pointer !important;
  }

  .account-profile {
    display: flex !important;
    align-items: center !important;
    gap: 13px !important;
    padding: 15px !important;
    margin-bottom: 18px !important;
    border: 1px solid rgba(255,255,255,.075) !important;
    border-radius: 18px !important;
    background: rgba(255,255,255,.035) !important;
  }

  .account-sheet-avatar {
    width: 48px !important;
    height: 48px !important;
    flex: 0 0 48px !important;
    display: grid !important;
    place-items: center !important;
    border-radius: 15px !important;
    background: rgba(106, 235, 169, .12) !important;
    border: 1px solid rgba(106, 235, 169, .25) !important;
    color: #70eca9 !important;
    font-size: 19px !important;
    font-weight: 800 !important;
  }

  .account-sheet-profile-copy {
    min-width: 0 !important;
    display: flex !important;
    flex-direction: column !important;
    gap: 4px !important;
  }

  .account-sheet-profile-copy strong {
    display: block !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
    white-space: nowrap !important;
    font-size: 14px !important;
    color: #edf5f5 !important;
  }

  .account-sheet-profile-copy span {
    font-size: 11px !important;
    color: #789197 !important;
  }

  .account-actions {
    display: grid !important;
    gap: 10px !important;
  }

  .account-action {
    width: 100% !important;
    min-height: 68px !important;
    display: grid !important;
    grid-template-columns: 42px minmax(0,1fr) 20px !important;
    align-items: center !important;
    gap: 11px !important;
    padding: 12px 13px !important;
    box-sizing: border-box !important;
    border-radius: 17px !important;
    text-align: left !important;
    cursor: pointer !important;
    transition: transform .15s ease, background .15s ease, border-color .15s ease !important;
  }

  .account-action:active {
    transform: scale(.985) !important;
  }

  .account-action-secondary {
    border: 1px solid rgba(99, 221, 164, .16) !important;
    background: rgba(99, 221, 164, .055) !important;
    color: #eff8f6 !important;
  }

  .account-action-danger {
    border: 1px solid rgba(255, 91, 102, .15) !important;
    background: rgba(255, 91, 102, .045) !important;
    color: #f4eeee !important;
  }

  .account-action-icon {
    width: 42px !important;
    height: 42px !important;
    display: grid !important;
    place-items: center !important;
    border-radius: 13px !important;
    background: rgba(255,255,255,.055) !important;
    color: #8fe9ba !important;
    font-size: 20px !important;
  }

  .account-action-danger .account-action-icon {
    color: #ff737b !important;
    background: rgba(255,91,102,.07) !important;
  }

  .account-action > span:nth-child(2) {
    min-width: 0 !important;
    display: flex !important;
    flex-direction: column !important;
    gap: 3px !important;
  }

  .account-action strong {
    font-size: 14px !important;
    line-height: 1.25 !important;
    color: inherit !important;
  }

  .account-action small {
    font-size: 10px !important;
    line-height: 1.3 !important;
    color: #789197 !important;
  }

  .account-action > b {
    color: #789197 !important;
    font-size: 22px !important;
    font-weight: 400 !important;
    text-align: right !important;
  }

  .account-sheet-cancel {
    width: 100% !important;
    min-height: 46px !important;
    margin-top: 13px !important;
    border: 0 !important;
    border-radius: 14px !important;
    background: transparent !important;
    color: #81989d !important;
    font-size: 13px !important;
    font-weight: 700 !important;
    cursor: pointer !important;
  }

  .account-sheet-cancel:active,
  .account-sheet-close:active {
    opacity: .7 !important;
  }

  body.account-sheet-open {
    overflow: hidden !important;
  }
}


/* ============================================================
   FORMFIT AUTH POLISH — account authentication only
   Password toggle + mobile-safe auth form controls.
   Does not affect camera, pose, pipes, exercises or scoring.
   ============================================================ */
.password-field{
  position:relative;
  display:flex;
  align-items:center;
  width:100%;
}
.password-field #authPassword{
  width:100%;
  padding-right:108px;
}
.password-toggle{
  position:absolute;
  right:10px;
  top:50%;
  transform:translateY(-50%);
  display:inline-flex;
  align-items:center;
  justify-content:center;
  gap:7px;
  min-width:76px;
  height:38px;
  padding:0 11px;
  border:1px solid rgba(121,242,164,.22);
  border-radius:10px;
  background:rgba(121,242,164,.07);
  color:#9bb2b6;
  font:700 11px/1 Inter,system-ui,sans-serif;
  letter-spacing:.3px;
  cursor:pointer;
  -webkit-tap-highlight-color:transparent;
  transition:background .18s ease,border-color .18s ease,color .18s ease;
}
.password-toggle:hover,
.password-toggle:focus-visible{
  background:rgba(121,242,164,.13);
  border-color:rgba(121,242,164,.42);
  color:#79f2a4;
  outline:none;
}
.password-toggle-icon{
  font-size:12px;
  line-height:1;
}
.password-toggle-text{
  line-height:1;
}
.auth-error{
  min-height:20px;
  margin-top:10px;
}
@media(max-width:700px){
  .password-field #authPassword{
    padding-right:96px;
  }
  .password-toggle{
    right:8px;
    min-width:68px;
    height:36px;
    padding:0 9px;
  }
}


/* =========================================================
   FormFit Diet Upgrade — BMI + Smart Meal Swaps
   ========================================================= */
.meal-bmi-preview{
  margin:12px 0 18px;
  padding:14px 16px;
  border:1px solid rgba(110,240,163,.18);
  border-radius:14px;
  background:rgba(7,25,27,.72);
  display:flex;
  align-items:center;
  gap:12px;
  flex-wrap:wrap;
}
.meal-bmi-preview span{
  font-size:10px;
  letter-spacing:.16em;
  font-weight:800;
  color:#7f989d;
}
.meal-bmi-preview strong{
  font-size:24px;
  color:#6ef0a3;
}
.meal-bmi-preview small{
  color:var(--muted);
  font-size:11px;
}
.meal-bmi-preview.is-ready small{color:#a9c0c3}

.diet-swap-suggestions{
  display:none;
  margin-top:16px;
  padding:16px;
  border:1px solid rgba(110,240,163,.16);
  border-radius:16px;
  background:rgba(8,25,28,.82);
}
.diet-swap-suggestions.is-open{display:block}
.diet-swap-head{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12px;
  margin-bottom:12px;
}
.diet-swap-head > div{
  display:flex;
  flex-direction:column;
  gap:4px;
  min-width:0;
}
.diet-swap-head strong{font-size:15px;line-height:1.25}
.diet-swap-target{color:#91a9ad;font-size:10px;margin-top:2px;line-height:1.5}
.diet-swap-note{font-size:10px;color:#a8bdbf;background:rgba(110,240,163,.045);border:1px solid rgba(110,240,163,.10);padding:9px 10px;border-radius:10px;margin:0 0 12px}

.diet-swap-close{
  width:30px;
  height:30px;
  border-radius:9px;
  border:1px solid rgba(255,255,255,.1);
  background:rgba(255,255,255,.04);
  color:var(--text);
  cursor:pointer;
  font-size:18px;
}
.diet-suggestion-grid{
  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:10px;
}
.diet-suggestion-card{
  text-align:left;
  border:1px solid rgba(255,255,255,.09);
  border-radius:14px;
  background:linear-gradient(145deg,rgba(255,255,255,.035),rgba(255,255,255,.018));
  padding:13px;
  color:var(--text);
  cursor:pointer;
  transition:transform .16s ease,border-color .16s ease,background .16s ease,box-shadow .16s ease;
  min-height:132px;
}
.diet-suggestion-card:active{transform:scale(.985)}
.diet-suggestion-top{display:flex;align-items:center;justify-content:space-between;gap:8px}
.diet-suggestion-check{font-size:8px;letter-spacing:.12em;font-weight:900;color:#72eaa5;border:1px solid rgba(110,240,163,.22);border-radius:999px;padding:4px 6px;white-space:nowrap}
.diet-suggestion-portion{display:block;margin-top:8px;color:#d8e7e8;font-size:11px;font-weight:800}
.diet-suggestion-macros{display:flex;flex-wrap:wrap;gap:5px;margin-top:8px}
.diet-suggestion-macros span,.diet-suggestion-macros b{font-size:9px;padding:4px 6px;border-radius:7px;background:rgba(16,45,51,.78);font-weight:800}

.diet-suggestion-card:hover{
  transform:translateY(-2px);
  border-color:rgba(110,240,163,.34);
  background:rgba(110,240,163,.05);
}
.diet-suggestion-name{
  display:block;
  font-weight:800;
  font-size:13px;
}
.diet-suggestion-meta{
  display:block;
  margin-top:5px;
  color:#9cb4b8;
  font-size:10px;
}
.diet-suggestion-card small{
  display:block;
  margin-top:8px;
  color:var(--muted);
  font-size:9px;
  line-height:1.4;
}
@media (max-width:700px){
  .diet-suggestion-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
  .diet-swap-suggestions{padding:13px}
}

/* Smart meal recipe UI */
 .meal-title-button{appearance:none;border:0;background:none;color:inherit;text-align:left;padding:0;cursor:pointer;display:block;width:100%}
.meal-title-button h3{margin:4px 0 0;font-size:18px}
.meal-title-button small{display:inline-flex;align-items:center;color:#9fc0b9;font-size:9px;font-weight:800;margin-top:8px;padding:5px 8px;border:1px solid #294c43;background:#0d211c;border-radius:999px;opacity:1;transition:.18s ease}
.meal-title-button:hover h3{transform:translateX(2px)}
.meal-title-button:hover small{border-color:#4f816e;color:#c9f0df;background:#102b24}
.meal-recipe-modal{position:fixed;inset:0;z-index:9999;display:none;align-items:center;justify-content:center;padding:20px}
.meal-recipe-modal.is-open{display:flex}
.meal-recipe-backdrop{position:absolute;inset:0;background:rgba(2,10,14,.78);backdrop-filter:blur(8px)}
.meal-recipe-dialog{position:relative;width:min(620px,94vw);max-height:88vh;overflow:auto;background:#0d1c21;border:1px solid rgba(130,190,190,.2);border-radius:22px;padding:24px;box-shadow:0 25px 80px rgba(0,0,0,.5);color:#eaf5f3}
.meal-recipe-close{position:absolute;right:14px;top:12px;width:34px;height:34px;border:0;border-radius:50%;background:#172c32;color:#dff3ef;font-size:24px;cursor:pointer}
.meal-recipe-dialog h3{font-size:26px;margin:7px 40px 10px 0}
.meal-recipe-meta{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:20px}
.meal-recipe-meta span{background:#142a30;border:1px solid rgba(130,190,190,.14);padding:7px 10px;border-radius:999px;font-size:11px;color:#b8d1cf}
.meal-recipe-section{margin-top:18px}.meal-recipe-section strong{font-size:12px;text-transform:uppercase;letter-spacing:.12em;color:#91bdb8}.meal-recipe-section ul,.meal-recipe-section ol{margin:9px 0 0;padding-left:20px;color:#d4e4e2}.meal-recipe-section li{margin:7px 0;font-size:13px;line-height:1.5}.meal-recipe-note{display:block;margin-top:18px;color:#71898e;font-size:10px;line-height:1.5}
@media(max-width:700px){
  .meal-card{padding:17px;border-radius:17px}
  .meal-card-head{gap:9px}
  .meal-card h3{font-size:17px}
  .meal-kcal{font-size:9px;padding:7px 8px}
  .meal-card-actions{grid-template-columns:1fr 1fr 1fr;gap:7px}
  .meal-action-btn{padding:8px 5px;font-size:9px;min-height:38px}
  .meal-edit-row{grid-template-columns:auto minmax(0,1fr) auto auto;gap:7px}
  .meal-edit-row .meal-qty-input{width:100%;min-width:0}
  .meal-edit-row > span{display:block;font-size:9px;color:#9bb0b3!important;white-space:nowrap;font-weight:800}
  .meal-edit-row .meal-qty-apply{min-width:62px}
}
@media(max-width:700px){.meal-recipe-modal{padding:10px}.meal-recipe-dialog{width:100%;max-height:92vh;padding:20px 17px;border-radius:18px}.meal-recipe-dialog h3{font-size:22px}.meal-title-button h3{font-size:16px}}
body.recipe-modal-open{overflow:hidden}


/* ============================================================
   FORMFIT — CAMERA SETUP COACH
   Guidance-only UI. It never changes pose/form decisions.
   ============================================================ */
.camera-setup-coach{
  position:absolute;
  z-index:8;
  top:16px;
  left:50%;
  transform:translateX(-50%);
  width:min(92%,560px);
  padding:13px 14px 12px;
  border:1px solid rgba(121,242,164,.28);
  border-radius:16px;
  background:rgba(4,12,15,.88);
  box-shadow:0 14px 40px rgba(0,0,0,.38), inset 0 1px 0 rgba(255,255,255,.04);
  backdrop-filter:blur(10px);
  -webkit-backdrop-filter:blur(10px);
  color:#fff;
  display:none;
  pointer-events:none;
}
.camera-setup-head{
  display:flex;
  align-items:center;
  gap:10px;
}
.camera-setup-icon{
  width:32px;
  height:32px;
  border-radius:10px;
  display:grid;
  place-items:center;
  flex:0 0 32px;
  background:rgba(121,242,164,.12);
  border:1px solid rgba(121,242,164,.25);
  color:var(--accent);
  font-size:20px;
}
.camera-setup-kicker{
  display:block;
  color:#7f969b;
  font-size:8px;
  font-weight:900;
  letter-spacing:1.8px;
  margin-bottom:2px;
}
.camera-setup-head strong{
  display:block;
  font:800 15px/1.15 Manrope,Inter,sans-serif;
}
.camera-setup-main{
  margin:9px 0 10px;
  color:#eaf5f2;
  font:700 13px/1.35 Inter,sans-serif;
}
.camera-setup-chips{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:7px;
}
.camera-setup-chip{
  min-width:0;
  padding:7px 8px;
  border-radius:9px;
  background:rgba(18,36,42,.82);
  border:1px solid #29434a;
}
.camera-setup-chip span{
  display:block;
  color:#789096;
  font-size:7px;
  font-weight:900;
  letter-spacing:1.2px;
  margin-bottom:3px;
}
.camera-setup-chip b{
  display:block;
  color:#e9f6f2;
  font-size:10px;
  font-weight:800;
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis;
}
.camera-setup-chip.good{
  border-color:rgba(121,242,164,.42);
  background:rgba(22,62,45,.62);
}
.camera-setup-chip.warn{
  border-color:rgba(244,211,94,.42);
  background:rgba(60,52,18,.68);
}
.camera-setup-chip.bad{
  border-color:rgba(255,92,112,.44);
  background:rgba(67,20,27,.68);
}
@media(max-width:700px){
  .camera-setup-coach{
    top:9px;
    width:calc(100% - 18px);
    padding:10px;
    border-radius:13px;
  }
  .camera-setup-main{font-size:11px;margin:7px 0 8px}
  .camera-setup-head strong{font-size:13px}
  .camera-setup-chips{grid-template-columns:repeat(2,1fr);gap:5px}
  .camera-setup-chip{padding:6px 7px}
}


/* FORMFIT — PERFORMANCE & SAFETY */
.performance-head{display:flex;justify-content:space-between;align-items:flex-start;gap:20px}.performance-badge{border:1px solid #6a2e38;background:#28151a;color:#ff9aa3;border-radius:999px;padding:10px 14px;font-size:10px;font-weight:900;letter-spacing:1.4px;white-space:nowrap}.performance-gate{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:18px;background:linear-gradient(135deg,#101f24,#171419);border:1px solid #4a3338;border-radius:18px;padding:22px;max-width:980px}.performance-gate-icon{width:58px;height:58px;border-radius:16px;display:grid;place-items:center;background:#25171c;border:1px solid #67323b;color:#ff9aa3;font:900 18px Manrope}.performance-gate h3{margin:5px 0 6px;font:800 19px Manrope}.performance-gate p{margin:0;color:var(--muted);line-height:1.6;font-size:12px}.performance-workspace{display:grid;gap:16px}.performance-warning{padding:13px 16px;border:1px solid #5b4930;background:#201b11;border-radius:13px;color:#dbc992;font-size:12px;line-height:1.55}.performance-grid{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:15px}.performance-profile-card{max-width:none}.performance-card-head{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;margin-bottom:20px}.performance-card-head h3{margin:6px 0 0;font:800 21px Manrope}.session-only{font-size:9px;color:var(--accent);border:1px solid #24563c;background:#0d2119;padding:6px 8px;border-radius:999px;letter-spacing:1px}.performance-profile-card textarea{width:100%;resize:vertical;background:#0a161b;color:var(--text);border:1px solid #233a41;border-radius:10px;padding:12px;outline:none}.performance-profile-card textarea:focus{border-color:#3c7660}.performance-profile-result{margin-top:15px;display:grid;gap:8px}.performance-profile-result:empty{display:none}.profile-result{padding:12px;border-radius:11px;background:#10241d;border:1px solid #28543f;color:#cdeedc;font-size:12px;line-height:1.55}.profile-result.warn{background:#281b12;border-color:#684a2a;color:#e8d39c}.performance-quick-card{background:var(--panel);border:1px solid var(--line);border-radius:17px;padding:21px;height:max-content}.performance-quick-card h3{font:800 20px Manrope;margin:7px 0 16px}.performance-tabs{display:grid;gap:7px}.performance-tab{background:#0a161b;color:var(--muted);border:1px solid #20363d;padding:11px 12px;border-radius:10px;text-align:left;font-weight:700;cursor:pointer}.performance-tab.active{background:#132b24;color:var(--accent);border-color:#2f654c}.performance-quick-card p{font-size:12px;line-height:1.65;color:var(--muted);margin:16px 0 0}.performance-library-head{display:flex;justify-content:space-between;align-items:end;gap:15px;margin-top:8px}.performance-library-head h3{font:800 22px Manrope;margin:6px 0 0}.performance-library-head input{max-width:330px}.performance-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.performance-card{background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:18px;min-height:190px}.performance-card .pc-top{display:flex;justify-content:space-between;gap:10px;align-items:flex-start}.performance-card h4{margin:0;font:800 16px Manrope}.performance-card .pc-type{font-size:8px;letter-spacing:1.2px;color:var(--accent);border:1px solid #24563c;padding:5px 7px;border-radius:999px;white-space:nowrap}.performance-card p{color:var(--muted);font-size:11px;line-height:1.65;margin:12px 0}.pc-meta{display:flex;flex-wrap:wrap;gap:6px}.pc-meta span{font-size:9px;color:#a9bdc1;background:#13242a;border-radius:6px;padding:5px 7px}.pc-risk{margin-top:11px;padding-top:10px;border-top:1px solid #1a2d33;color:#d8c99b;font-size:10px;line-height:1.5}.pc-risk b{color:#f0db8f}.performance-disclaimer{padding:15px 17px;border:1px solid #3a4144;background:#11191d;border-radius:14px;color:#9db0b4;font-size:11px;line-height:1.65}.performance-disclaimer strong{color:#fff}.performance-workspace[hidden]{display:none}
@media(max-width:850px){.performance-grid{grid-template-columns:1fr}.performance-cards{grid-template-columns:1fr 1fr}.performance-gate{grid-template-columns:auto 1fr}.performance-gate button{grid-column:1/-1;width:100%}.performance-library-head{display:block}.performance-library-head input{max-width:none;margin-top:12px}.performance-head{display:block}.performance-badge{display:inline-block;margin-top:10px}}
@media(max-width:600px){.performance-cards{grid-template-columns:1fr}.performance-gate{padding:17px;gap:12px}.performance-gate-icon{width:48px;height:48px}.performance-card-head{display:block}.session-only{display:inline-block;margin-top:9px}}

/* Steroid education expansion — educational only, no dosing/cycle UI */
.steroid-basics{margin:24px 0;border:1px solid rgba(255,255,255,.08);border-radius:24px;padding:22px;background:linear-gradient(180deg,rgba(255,255,255,.045),rgba(255,255,255,.018));}
.steroid-basics-head{display:flex;justify-content:space-between;gap:20px;align-items:flex-start;margin-bottom:16px}.steroid-basics-head h3{margin:5px 0 6px}.steroid-basics-head p{margin:0;max-width:820px;color:var(--muted)}
.steroid-basics-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:12px}.steroid-basics-grid article{padding:16px;border-radius:18px;background:rgba(0,0,0,.14);border:1px solid rgba(255,255,255,.06)}.steroid-basics-grid b{display:block;margin-bottom:7px}.steroid-basics-grid p{margin:0;color:var(--muted);line-height:1.55;font-size:.9rem}
.steroid-paths{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin-top:12px}.steroid-paths>div{display:flex;flex-direction:column;gap:5px;padding:14px 16px;border-radius:16px;border:1px solid rgba(255,255,255,.06);background:rgba(255,255,255,.025)}.steroid-paths span{color:var(--muted);font-size:.88rem;line-height:1.45}
.pc-mechanism{margin:10px 0;padding:11px 12px;border-radius:13px;background:rgba(255,255,255,.035);line-height:1.5;color:var(--muted);font-size:.9rem}.pc-mechanism b{color:var(--text)}
@media(max-width:1100px){.steroid-basics-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.steroid-paths{grid-template-columns:1fr}}
@media(max-width:640px){.steroid-basics{padding:16px;border-radius:18px}.steroid-basics-head{flex-direction:column}.steroid-basics-grid{grid-template-columns:1fr}.steroid-basics-grid article{padding:14px}.steroid-paths{grid-template-columns:1fr}.pc-mechanism{font-size:.86rem}}


/* Diet supplements — isolated additions only */
.meal-supplement-mode-grid{grid-template-columns:1fr}
.meal-supplement-options{margin-top:12px;padding:14px;border:1px solid #20363d;border-radius:15px;background:#0b171c}
.diet-supplement-options-head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:12px}
.diet-supplement-options-head strong{display:block;color:#eaf4f2;font:800 13px Manrope}
.diet-supplement-options-head small{display:block;color:#71888d;font-size:10px;margin-top:4px}
.diet-supplement-options-head>span{color:var(--accent);font-size:10px;font-weight:800;white-space:nowrap}
.diet-supplement-check-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:9px}
.diet-supplement-check{display:flex;align-items:flex-start;gap:9px;padding:11px;border:1px solid #203941;border-radius:12px;background:#09151a;cursor:pointer}
.diet-supplement-check:hover{border-color:#42715e}
.diet-supplement-check input{margin-top:3px;accent-color:var(--accent)}
.diet-supplement-check span{min-width:0}
.diet-supplement-check b{font-size:11px;color:#eaf4f2}
.diet-supplement-check small{display:block;color:#71888d;font-size:9px;margin-top:3px}
.diet-supplement-card{background:var(--panel);border:1px solid var(--line);border-radius:18px;padding:19px;margin-bottom:16px}
.diet-supplement-head{display:flex;justify-content:space-between;align-items:center;gap:14px}
.diet-supplement-card h3{margin:5px 0 0;font:800 18px Manrope}
.diet-supplement-card p{margin:5px 0 0;color:var(--muted);font-size:11px;line-height:1.5}
.diet-supplement-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-top:14px}
.diet-supplement-item{display:flex;gap:10px;padding:12px;border:1px solid #203941;border-radius:13px;background:#0a171c}
.diet-supplement-icon{width:32px;height:32px;display:grid;place-items:center;flex:0 0 32px;border-radius:9px;background:#10272a;font-size:17px}
.diet-supplement-item strong{display:block;color:#eaf4f2;font-size:12px}
.diet-supplement-item span{display:block;color:var(--accent);font-size:9px;margin-top:3px}
.diet-supplement-item small{display:block;color:#879da1;font-size:9px;line-height:1.45;margin-top:5px}
.diet-supplement-item em{display:block;color:#647c81;font-size:8px;line-height:1.45;margin-top:4px;font-style:normal}
.diet-supplement-note{margin-top:12px!important;color:#667f85!important;font-size:9px!important}
@media (max-width:700px){.meal-supplement-mode-grid,.diet-supplement-check-grid,.diet-supplement-grid{grid-template-columns:1fr}.diet-supplement-options-head,.diet-supplement-head{align-items:flex-start;flex-direction:column}}


/* Diet workout-aware supplement timing — isolated addition */
.meal-workout-time-grid{grid-template-columns:repeat(3,1fr)}
.meal-workout-time-help{display:block;margin-top:9px;color:var(--muted);font-size:10px;line-height:1.5}
.diet-workout-timing-card{background:var(--panel);border:1px solid var(--line);border-radius:18px;padding:17px 19px;margin-bottom:16px}
.diet-workout-timing-card h3{margin:5px 0 0;font:800 18px Manrope}
.diet-workout-timing-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:9px;margin-top:14px}
.diet-workout-timing-grid>div{padding:11px 12px;border:1px solid #203941;border-radius:12px;background:#0a171c}
.diet-workout-timing-grid b{display:block;color:var(--accent);font-size:9px;letter-spacing:.12em}
.diet-workout-timing-grid span{display:block;color:#dce9e7;font-size:11px;margin-top:5px}
.meal-supplement-block{margin:0 0 12px;padding:11px 12px;border:1px solid #24453e;border-radius:13px;background:#0b1d1b}
.meal-supplement-block-head{display:flex;justify-content:space-between;gap:10px;align-items:center;margin-bottom:8px}
.meal-supplement-block-head span{color:var(--accent);font-size:9px;font-weight:900;letter-spacing:.14em}
.meal-supplement-block-head small{color:#71888d;font-size:9px}
.meal-supplement-meal-list{display:grid;gap:7px}
.meal-supplement-line{display:flex;align-items:flex-start;gap:9px;padding:8px 9px;border-radius:10px;background:#081613}
.meal-supplement-icon{width:27px;height:27px;display:grid;place-items:center;border-radius:8px;background:#102923;flex:0 0 27px}
.meal-supplement-line strong{display:block;color:#edf7f4;font-size:10px}
.meal-supplement-line span{display:block;color:var(--accent);font-size:8px;font-weight:800;margin-top:2px}
.meal-supplement-line small{display:block;color:#7d9498;font-size:8px;line-height:1.4;margin-top:3px}
@media (max-width:700px){.meal-workout-time-grid,.diet-workout-timing-grid{grid-template-columns:1fr}.meal-workout-time-help{font-size:9px}}

/* Supplements visual polish — isolated to the diet supplement UI */
.diet-supplement-check{
  position:relative;
  display:block;
  padding:0;
  overflow:hidden;
  border:1px solid #203941;
  border-radius:16px;
  background:linear-gradient(145deg,#0b191e,#081419);
  transition:border-color .18s ease,transform .18s ease,box-shadow .18s ease,background .18s ease;
}
.diet-supplement-check:hover{
  border-color:#315a51;
  transform:translateY(-1px);
}
.diet-supplement-check:has(input:checked){
  border-color:rgba(105,232,160,.72);
  background:linear-gradient(145deg,#0d211f,#09181a);
  box-shadow:0 0 0 1px rgba(105,232,160,.10),0 10px 24px rgba(0,0,0,.16);
}
.diet-supplement-check input{
  position:absolute;
  opacity:0;
  pointer-events:none;
  width:1px;
  height:1px;
}
.supplement-check-body{
  position:relative;
  display:grid!important;
  grid-template-columns:54px minmax(0,1fr) 24px;
  align-items:center;
  gap:12px;
  min-height:76px;
  padding:11px 12px;
  color:inherit!important;
}
.supplement-check-body>img{
  display:block;
  width:54px;
  height:54px;
  border-radius:13px;
  object-fit:cover;
  border:1px solid #25444a;
  background:#0c2225;
  box-shadow:inset 0 0 0 1px rgba(255,255,255,.025);
}
.supplement-check-body>span{
  min-width:0;
  display:block;
}
.supplement-check-body b{
  display:block;
  color:#eaf5f2;
  font-size:12px;
  line-height:1.25;
  letter-spacing:-.01em;
}
.supplement-check-body small{
  display:block;
  margin-top:4px;
  color:#70888d;
  font-size:9px;
  line-height:1.35;
}
.supplement-check-mark{
  width:22px;
  height:22px;
  display:grid!important;
  place-items:center;
  border:1px solid #365159;
  border-radius:7px;
  color:transparent;
  background:#0b171b;
  font-style:normal;
  font-size:14px;
  font-weight:900;
  transition:all .18s ease;
}
.diet-supplement-check:has(input:checked) .supplement-check-mark{
  color:#082017;
  border-color:#69e8a0;
  background:#69e8a0;
  box-shadow:0 0 0 3px rgba(105,232,160,.08);
}
.diet-supplement-icon,.meal-supplement-icon{
  overflow:hidden;
  padding:0!important;
  border:1px solid #24454b;
}
.diet-supplement-icon img,.meal-supplement-icon img{
  display:block;
  width:100%;
  height:100%;
  object-fit:cover;
}
.diet-supplement-item{
  align-items:flex-start;
}
.diet-supplement-item .diet-supplement-icon{
  width:42px;
  height:42px;
  flex-basis:42px;
  border-radius:11px;
}
.meal-supplement-line .meal-supplement-icon{
  width:34px;
  height:34px;
  flex-basis:34px;
  border-radius:9px;
}
@media (max-width:700px){
  .supplement-check-body{grid-template-columns:52px minmax(0,1fr) 22px;gap:10px;min-height:72px;padding:10px}
  .supplement-check-body>img{width:52px;height:52px}
  .supplement-check-body b{font-size:11px}
}
