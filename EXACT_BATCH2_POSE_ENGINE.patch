+def _best_side_pose(lm, width, height):
+    candidates = []
+    for label, sid, hid, kid, aid in (
+        ("LEFT", LEFT_SHOULDER, LEFT_HIP, LEFT_KNEE, LEFT_ANKLE),
+        ("RIGHT", RIGHT_SHOULDER, RIGHT_HIP, RIGHT_KNEE, RIGHT_ANKLE),
+    ):
+        ids = (sid, hid, kid, aid)
+        if all(visible(lm, i, 0.45) for i in ids):
+            score = sum(float(getattr(lm[i], "visibility", 0.0)) for i in ids)
+            candidates.append((score, label, sid, hid, kid, aid))
+    return max(candidates, key=lambda x: x[0]) if candidates else None
+
+
+def _analyze_vertical_pull(landmarks, width, height, exercise):
+    required = (LEFT_SHOULDER, LEFT_ELBOW, LEFT_WRIST,
+                RIGHT_SHOULDER, RIGHT_ELBOW, RIGHT_WRIST)
+    if not all(visible(landmarks, i, 0.45) for i in required):
+        return FormResult("red", "KEEP BOTH ARMS VISIBLE", 0, {}, [], [], "FRONT", False)
+    ls = xy(landmarks, LEFT_SHOULDER, width, height)
+    le = xy(landmarks, LEFT_ELBOW, width, height)
+    lw = xy(landmarks, LEFT_WRIST, width, height)
+    rs = xy(landmarks, RIGHT_SHOULDER, width, height)
+    re_ = xy(landmarks, RIGHT_ELBOW, width, height)
+    rw = xy(landmarks, RIGHT_WRIST, width, height)
+    angles = {}
+    left_elbow = angle(ls, le, lw)
+    right_elbow = angle(rs, re_, rw)
+    vals = [v for v in (left_elbow, right_elbow) if v is not None]
+    if vals:
+        angles["elbow"] = sum(vals) / len(vals)
+    pipes = [(ls, le, "green"), (le, lw, "green"), (rs, re_, "green"), (re_, rw, "green")]
+    status, score = "green", 96
+    message = f"{EXERCISE_METADATA.get(exercise, {}).get('name', exercise).upper()} FORM GOOD"
+    targets = []
+    if len(vals) == 2 and abs(left_elbow - right_elbow) > 22:
+        status, score, message = "yellow", 76, "KEEP BOTH ARMS MOVING EVENLY"
+        targets.extend([(le, (ls[0], le[1]), "LEFT ELBOW PATH"), (re_, (rs[0], re_[1]), "RIGHT ELBOW PATH")])
+    return FormResult(status, message, score, angles, pipes, targets, "FRONT", status == "green")
+
+
+def _analyze_row_family(landmarks, width, height, exercise):
+    best = _best_side_pose(landmarks, width, height)
+    if not best:
+        return FormResult("red", "TURN SIDEWAYS AND SHOW FULL BODY", 0, {}, [], [], "SIDE", False)
+    _, side, sid, hid, kid, aid = best
+    eid = LEFT_ELBOW if side == "LEFT" else RIGHT_ELBOW
+    wid = LEFT_WRIST if side == "LEFT" else RIGHT_WRIST
+    shoulder = xy(landmarks, sid, width, height)
+    hip = xy(landmarks, hid, width, height)
+    knee = xy(landmarks, kid, width, height)
+    ankle = xy(landmarks, aid, width, height)
+    elbow = xy(landmarks, eid, width, height) if visible(landmarks, eid, 0.45) else None
+    wrist = xy(landmarks, wid, width, height) if visible(landmarks, wid, 0.45) else None
+    if elbow is None or wrist is None:
+        return FormResult("red", "KEEP SHOULDER, ELBOW AND WRIST VISIBLE", 0, {}, [], [], "SIDE", False)
+    torso_angle = angle((shoulder[0], shoulder[1] - max(distance(shoulder, hip), 1)), shoulder, hip)
+    elbow_angle = angle(shoulder, elbow, wrist)
+    angles = {k: v for k, v in (("torso_angle", torso_angle), ("elbow", elbow_angle)) if v is not None}
+    pipes = [(shoulder, elbow, "green"), (elbow, wrist, "green"), (hip, knee, "green"), (knee, ankle, "green")]
+    status, score = "green", 97
+    message = f"{EXERCISE_METADATA.get(exercise, {}).get('name', exercise).upper()} FORM GOOD"
+    targets = []
+    minimum = 105 if exercise in {"seated_cable_row", "chest_supported_row", "machine_row", "face_pull"} else 92
+    if torso_angle is not None and torso_angle < minimum:
+        status, score, message = "yellow", 74, "KEEP A CONTROLLED BACK POSITION"
+        targets.append((shoulder, (hip[0], shoulder[1]), "BACK CONTROL"))
+    if elbow_angle is not None and elbow_angle > 170:
+        status, score, message = "yellow", min(score, 78), "PULL WITH THE ELBOWS"
+        targets.append((elbow, (shoulder[0], elbow[1]), "DRIVE ELBOW BACK"))
+    return FormResult(status, message, score, angles, pipes, targets, "SIDE", status == "green")
+
+
