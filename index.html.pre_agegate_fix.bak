<script>
/* FORMFIT PRO ACCOUNT UX
   UI/session bridge only. AI pose/model/pipes logic remains in app.js. */
(() => {
  const $ = (s) => document.querySelector(s);

  async function session() {
    try {
      const r = await fetch("/api/auth/me", {
        credentials: "same-origin",
        cache: "no-store"
      });
      return await r.json();
    } catch (_) {
      return { authenticated: false };
    }
  }

  function showLogin() {
    const overlay = $("#authOverlay");
    if (!overlay) return;
    overlay.classList.add("visible");
    overlay.setAttribute("aria-hidden", "false");
    const email = $("#authEmail");
    if (email) setTimeout(() => email.focus(), 80);
  }

  function showHistory() {
    const button = document.querySelector('[data-view="history"]');
    if (button) {
      button.click();
      return;
    }
    const view = $("#historyView");
    if (view) view.classList.add("active-view");
  }

  async function accountClick() {
    const data = await session();
    if (data.authenticated) {
      window.dispatchEvent(new CustomEvent("formfit:open-account"));
    } else {
      showLogin();
    }
  }

  // Capture phase makes ACCOUNT work regardless of other UI listeners.
  document.addEventListener("click", (event) => {
    const target = event.target.closest("#accountBtn, .account-card");
    if (!target || event.target.closest("#logoutBtn")) return;
    event.preventDefault();
    event.stopPropagation();
    accountClick();
  }, true);

  // Professional first-visit auth gate.
  async function firstVisitGate() {
    const data = await session();
    if (!data.authenticated && !window.__formfitAuthTransition) showLogin();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", firstVisitGate, {once: true});
  } else {
    firstVisitGate();
  }
})();
</script>


<script data-formfit-auth-tabs-fixed="1">
/* FORMFIT AUTH TABS FIX — UI/auth only.
   Does not touch pose, pipes, camera, exercise logic, or model. */
(() => {
  const $ = (s) => document.querySelector(s);
  const tabs = document.querySelectorAll(".auth-tab[data-auth-mode]");
  const form = $("#authForm");
  const overlay = $("#authOverlay");
  const title = $("#authTitle");
  const subtitle = $("#authSubtitle");
  const submit = $("#authSubmit");
  const error = $("#authError");
  const email = $("#authEmail");
  const password = $("#authPassword");
  const passwordToggle = $("#authPasswordToggle");

  let mode = "login";

  function updatePasswordToggle() {
    if (!password || !passwordToggle) return;
    const shown = password.type === "text";
    passwordToggle.setAttribute("aria-pressed", shown ? "true" : "false");
    passwordToggle.setAttribute("aria-label", shown ? "Hide password" : "Show password");
    const text = passwordToggle.querySelector(".password-toggle-text");
    if (text) text.textContent = shown ? "Hide" : "Show";
    const icon = passwordToggle.querySelector(".password-toggle-icon");
    if (icon) icon.textContent = shown ? "◉" : "◌";
  }

  passwordToggle?.addEventListener("click", (event) => {
    event.preventDefault();
    if (!password) return;
    password.type = password.type === "password" ? "text" : "password";
    updatePasswordToggle();
    password.focus();
  });

  function setMode(nextMode) {
    mode = nextMode === "register" ? "register" : "login";

    tabs.forEach(tab => {
      tab.classList.toggle(
        "active",
        tab.dataset.authMode === mode
      );
    });

    if (title) {
      title.textContent =
        mode === "register"
          ? "Create your account."
          : "Welcome back.";
    }

    if (subtitle) {
      subtitle.textContent =
        mode === "register"
          ? "Create your private account to save workouts, reps and progress."
          : "Sign in to keep your workouts, reps and progress saved.";
    }

    if (submit) {
      submit.textContent =
        mode === "register"
          ? "Create account →"
          : "Login & continue →";
    }

    if (password) {
      password.autocomplete =
        mode === "register"
          ? "new-password"
          : "current-password";
    }

    if (error) error.textContent = "";
  }

  tabs.forEach(tab => {
    tab.addEventListener("click", (event) => {
      event.preventDefault();
      event.stopPropagation();
      setMode(tab.dataset.authMode);
      if (email) setTimeout(() => email.focus(), 30);
    });
  });

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();

    const userEmail = email?.value.trim() || "";
    const userPassword = password?.value || "";

    if (error) error.textContent = "";

    if (!userEmail || !userPassword) {
      if (error) error.textContent = "Enter your email and password.";
      return;
    }

    if (mode === "register" && userPassword.length < 8) {
      if (error) error.textContent = "Password must be at least 8 characters.";
      return;
    }

    const endpoint =
      mode === "register"
        ? "/api/auth/register"
        : "/api/auth/login";

    if (submit) {
      submit.disabled = true;
      submit.textContent =
        mode === "register"
          ? "Creating account…"
          : "Signing in…";
    }

    try {
      window.__formfitAuthTransition = true;
      const response = await fetch(endpoint, {
        method: "POST",
        headers: {"Content-Type": "application/json"},
        credentials: "same-origin",
        body: JSON.stringify({
          email: userEmail,
          password: userPassword
        })
      });

      const data = await response.json().catch(() => ({}));

      if (!response.ok) {
        if (error) {
          if (response.status === 409 && mode === "register") {
            error.textContent = "An account with this email already exists. Switch to Login.";
          } else {
            error.textContent =
              data.error ||
              (mode === "register"
                ? "Could not create account. Please try again."
                : "Incorrect email or password.");
          }
        }
        return;
      }

      // Login/register is complete. Always return to the main website view
      // instead of leaving the user on an auth overlay/hash.
      if (typeof showView === "function") {
        showView("home");
      } else {
        window.location.hash = "";
      }

      if (overlay) {
        overlay.classList.remove("visible", "open");
        overlay.setAttribute("aria-hidden", "true");
      }

      // Keep the existing dashboard/account UI in sync.
      const accountEmail = $("#accountEmail");
      const accountAvatar = $("#accountAvatar");
      const savedEmail =
        data?.user?.email || userEmail;

      if (accountEmail) accountEmail.textContent = savedEmail;
      if (accountAvatar) {
        accountAvatar.textContent =
          savedEmail.charAt(0).toUpperCase();
      }

      form.reset();
      setMode("login");
    } catch (_) {
      if (error) {
        error.textContent =
          "Server connection failed. Make sure the FormFit server is running.";
      }
    } finally {
      window.__formfitAuthTransition = false;
      if (submit) {
        submit.disabled = false;
        submit.textContent =
          mode === "register"
            ? "Create account →"
            : "Login & continue →";
      }
    }
  });

  setMode("login");
})();
</script>


<script data-formfit-auth-boot-safe="1">
/* FORMFIT AUTH BOOT SAFETY — auth UI only.
   Existing login/register/logout logic is preserved. */
(() => {
  const $ = (s) => document.querySelector(s);

  async function syncAuthUI() {
    const overlay = $("#authOverlay");
    const emailEl = $("#accountEmail");
    const avatarEl = $("#accountAvatar");

    if (!overlay) return;

    try {
      const response = await fetch("/api/auth/me", {
        credentials: "same-origin",
        cache: "no-store"
      });

      const data = await response.json();

      if (data?.authenticated && data?.user?.email) {
        const email = String(data.user.email);
        if (emailEl) emailEl.textContent = email;
        if (avatarEl) avatarEl.textContent = email.charAt(0).toUpperCase();

        overlay.classList.remove("visible");
        overlay.setAttribute("aria-hidden", "true");
      } else {
        if (emailEl) emailEl.textContent = "Not signed in";
        if (avatarEl) avatarEl.textContent = "U";

        overlay.classList.add("visible");
        overlay.setAttribute("aria-hidden", "false");
      }
    } catch (_) {
      // Keep the existing sign-in UI available during a cold-start/transient failure.
      overlay.classList.add("visible");
      overlay.setAttribute("aria-hidden", "false");
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", syncAuthUI, { once: true });
  } else {
    syncAuthUI();
  }
})();
</script>


<script data-formfit-mobile-account="1">
/* FORMFIT MOBILE ACCOUNT SHEET
   Account UI/session actions only. Does not touch camera, pose, pipes, exercises or scoring. */
(() => {
  const $ = (s) => document.querySelector(s);
  const overlay = $("#accountSheetOverlay");
  const emailEl = $("#accountSheetEmail");
  const avatarEl = $("#accountSheetAvatar");
  const accountEmail = $("#accountEmail");
  const accountAvatar = $("#accountAvatar");
  const authOverlay = $("#authOverlay");
  if (!overlay) return;

  function syncProfile() {
    const email = (accountEmail?.textContent || "").trim();
    const avatar = (accountAvatar?.textContent || "U").trim() || "U";
    if (emailEl) emailEl.textContent = email || "Not signed in";
    if (avatarEl) avatarEl.textContent = avatar.charAt(0).toUpperCase();
  }

  function openSheet() {
    syncProfile();
    overlay.classList.add("open");
    overlay.setAttribute("aria-hidden", "false");
    document.body.classList.add("account-sheet-open");
  }

  function closeSheet() {
    overlay.classList.remove("open");
    overlay.setAttribute("aria-hidden", "true");
    document.body.classList.remove("account-sheet-open");
  }

  function openLogin() {
    closeSheet();
    if (authOverlay) {
      authOverlay.classList.add("visible");
      authOverlay.classList.add("open");
      authOverlay.setAttribute("aria-hidden", "false");
      const title = $("#authTitle");
      const subtitle = $("#authSubtitle");
      if (title) title.textContent = "Welcome back.";
      if (subtitle) subtitle.textContent = "Sign in with the account you want to use.";
      const email = $("#authEmail");
      const password = $("#authPassword");
      if (email) { email.value = ""; email.focus(); }
      if (password) password.value = "";
      const error = $("#authError");
      if (error) error.textContent = "";
    }
  }

  async function signOut() {
    const btn = $("#accountSignoutBtn");
    if (btn) btn.disabled = true;
    try {
      await fetch("/api/auth/logout", {
        method: "POST",
        credentials: "same-origin",
        cache: "no-store"
      });
    } catch (_) {}
    try {
      if (typeof window.stopFormSession === "function") window.stopFormSession();
    } catch (_) {}

    if (accountEmail) accountEmail.textContent = "Not signed in";
    if (accountAvatar) accountAvatar.textContent = "U";
    syncProfile();
    closeSheet();
    openLogin();
    if (btn) btn.disabled = false;
  }

  window.addEventListener("formfit:open-account", openSheet);

  $("#accountSheetClose")?.addEventListener("click", closeSheet);
  $("#accountSheetCancel")?.addEventListener("click", closeSheet);
  $("#accountSwitchBtn")?.addEventListener("click", async () => {
    // Switching accounts first ends the current session, then opens the existing login UI.
    try {
      await fetch("/api/auth/logout", {
        method: "POST",
        credentials: "same-origin",
        cache: "no-store"
      });
    } catch (_) {}
    if (accountEmail) accountEmail.textContent = "Not signed in";
    if (accountAvatar) accountAvatar.textContent = "U";
    openLogin();
  });
  $("#accountSignoutBtn")?.addEventListener("click", signOut);

  overlay.addEventListener("click", (event) => {
    if (event.target === overlay) closeSheet();
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && overlay.classList.contains("open")) closeSheet();
  });

  // Keep the sheet profile synchronized if the existing auth UI updates the account.
  const profileObserver = new MutationObserver(syncProfile);
  if (accountEmail) profileObserver.observe(accountEmail, {childList:true, characterData:true, subtree:true});
  if (accountAvatar) profileObserver.observe(accountAvatar, {childList:true, characterData:true, subtree:true});
})();
</script>

</body>
</html>
