+def analyze_pec_deck(landmarks, width, height):
+    """Dedicated Pec Deck analyzer.
+
+    The camera can reliably observe the same front-view arm-opening/closing
+    geometry used by chest fly. Keep the proven geometry, but expose
+    exercise-specific coaching so Pec Deck is no longer routed as a generic
+    alias in the dispatch layer.
+    """
+    result = analyze_chest_fly(landmarks, width, height)
+    if result.status == "green":
+        result.message = "PEC DECK FORM GOOD"
+    elif result.status == "yellow":
+        result.message = "CONTROL PEC DECK RANGE"
+    elif result.status == "red":
+        result.message = "KEEP BOTH ARMS EVEN"
+    return result
+
+
